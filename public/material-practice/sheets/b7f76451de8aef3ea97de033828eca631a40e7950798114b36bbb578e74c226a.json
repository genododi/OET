er": {"text": "S4 At The Apex", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 20, "prompt": ": Echocardiogram shows (20) ______                 normal thickening of the left ventricle\n     with mildly dilated ventricle, EF of 40%,", "sourcePage": 64, "choices": [], "kind": "blank", "answer": {"text": "Mild Biatrial Enlargement", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 21, "prompt": "with mildly dilated ventricle, EF of 40%, (21) ______                and diastolic dysfunction, grade 2.", "sourcePage": 64, "choices": [], "kind": "blank", "answer": {"text": "Mild Mitral Regurgitation", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 22, "prompt": ": Nuclear stress study shows (22) ______            no reversible ischemia identified.\n     Laboratory data shows normal white cells, hemoglobin 11. BUN of 12.1, creatinine of 0.8.\n     Troponin of 0.04. BNP of 5700. Had no syncope.", "sourcePage": 64, "choices": [], "kind": "blank", "answer": {"text": "Fixed Inferolateral Defects", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 23, "prompt": "Impression : cardiomyopathy, (23) ______", "sourcePage": 64, "choices": [], "kind": "blank", "answer": {"text": "Ischemic With Exacerbation Of Symptoms", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 24, "prompt": "Further treatment : Electrophysiology study is required for ventricular tachycardia.\n     (24) ______              will be determined at a later stage.", "sourcePage": 64, "choices": [], "kind": "blank", "answer": {"text": "Defibrillator", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["b7f76451de8aef3ea97de033828eca631a40e7950798114b36bbb578e74c226a"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [73]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-6-B", "label": "British Academy · Task 6 · Part B", "part": "B", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [65, 66, 67], "questions": [{"number": 25, "prompt": "You hear a monologue by a physician explaining about Lupus disease.\n\nLupus disease;\n\nA. Causes the antibodies to act against antigens.\n\nB. Leads the immune system to act against antibodies.\n\nC. Causes antibodies to act against the healthy tissues\n\n\n\n\nANSWER :", "sourcePage": 65, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 26, "prompt": "You hear a discussion between a doctor and a nurse on leukopenia disease.\n\nThe white blood cell that can mend the damaged tissue is;\n\nA. Lymphocytes\n\nB. Monocytes\n\nC. Basophils", "sourcePage": 65, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 27, "prompt": "You hear a discussion between a doctor and a nurse on different stages of gout.\n\nIn which of the following gout stages the joints are irritated by calcium phosphate crystals?\n\nA. Pseudogout\n\nB. Intercritical stage\n\nC. Chronic tophaceous stage", "sourcePage": 66, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 28, "prompt": "You hear a discussion between a doctor and a nurse on different types of gum graft\nsurgery.\n\nWhich gum graft surgeries is performed for the individuals with inadequate gums?\n\nA. Pedicle grafts\n\nB. Gingival grafts\n\nC. Connective tissue grafts", "sourcePage": 66, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 29, "prompt": "You hear a discussion between a doctor and a nurse about medical conditions that\ncause undigested food to appear in the stool.\n\nIn which of the following diseases the patient becomes incapable to digest gluten in grains?\n\nA. Celiac disease\n\nB. Crohn’s disease\n\n\n\nC. Pancreatic insufficiency", "sourcePage": 66, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 30, "prompt": "You hear a discussion between a doctor and a nurse about different procedures to\ndetect blood clots.\n\nWhich of the following procedures uses catheterization technique?\n\nA. Endocardiography\n\nB. Ventilation-perfusion\n\nC. Angiography\n\n                                              Part C\nIn this part of the test, you'll hear two different extracts. In each extract, you'll hear health\nprofessionals talking about specific aspects of their work.\n\nFor questions, 31 to 42 choose the answer (A, B, or C) which fits best according to what you\nhear. Complete the answers as you listen the audio.\n\nNow, look at extract one.", "sourcePage": 67, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["b7f76451de8aef3ea97de033828eca631a40e7950798114b36bbb578e74c226a"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [73]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-6-C", "label": "British Academy · Task 6 · Part C", "part": "C", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [68, 69, 70, 71, 72], "questions": [{"number": 31, "prompt": "Which of the following statements is correct?\n\nA. Viruses and bacteria are antigens\n\nB. Red blood cell antigens are protein molecules\n\nC. Red blood cells produce antibodies", "sourcePage": 68, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 32, "prompt": "In which of the following blood groups the plasma does not contain anti-A antibodies?\n\nA. B group\n\nB. AB group\n\nC. A group", "sourcePage": 68, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 33, "prompt": "What is the criterion that makes the blood type for transfusing to the patient with any\nblood group?\n\nA. Having none of A or B antibodies\n\nB. Having none of A or B antigens\n\nC. Having A antigen and and anti-B antibody", "sourcePage": 69, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 34, "prompt": "In the US 39 percent of the population are with;\n\nA. A positive blood\n\nB. RhD-positive blood\n\nC. O positive blood", "sourcePage": 69, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 35, "prompt": "Which of the following blood types is considered as ‘Universal Donor Type’\n\nA. O negative\n\nB. O positive\n\nC. AB positive", "sourcePage": 69, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 36, "prompt": "What is a sensitization during pregnancy?\n\nA. If the antibody from the mother attacks red blood cells of the fetus\n\nB. If the RhD from the fetus attacks the red blood cells of the mother\n\n\n\nC. If the RhD from the mother attacks the red blood cells of the fetus", "sourcePage": 69, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 37, "prompt": "Which of the following types of eczema occurs due to inhalant allergies?\n\nA. Irritant dermatitis\n\nB. Allergic contact dermatitis\n\nC. Atopic dermatitis", "sourcePage": 70, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 38, "prompt": "What occurs due to poor blood blood circulations in the veins of the legs?\n\nA. Atopic dermatitis\n\nB. Stasis dermatitis\n\nC. Irritant dermatitis", "sourcePage": 70, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 73, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e61