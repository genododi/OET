2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 2, "prompt": "had full thickness (2) ______                close to defect in his posterior thigh. In\nseveral areas along the graft site and low in the leg, there are several hypergranulation tissue\ndeveloped.", "sourcePage": 145, "choices": [], "kind": "blank", "answer": {"text": "Skin Grafting", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 3, "prompt": "Past medical history : (3) ______", "sourcePage": 145, "choices": [], "kind": "blank", "answer": {"text": "Clostridium Difficile", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 4, "prompt": "Medications : Cipro and (4) ______", "sourcePage": 145, "choices": [], "kind": "blank", "answer": {"text": "Flagyl", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 5, "prompt": "Family history of illness : maternal grandmother had (5) ______                   father had prostate\ncancer, and he has having heart disease and diabetes.", "sourcePage": 145, "choices": [], "kind": "blank", "answer": {"text": "Pancreatic Cancer.", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 6, "prompt": "Diagnosis : Cardiology reports are regular. There is no (6) ______", "sourcePage": 145, "choices": [], "kind": "blank", "answer": {"text": "S3, S4, Or Gallop", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 7, "prompt": ": left lower extremity is significant for the (7) ______", "sourcePage": 146, "choices": [], "kind": "blank", "answer": {"text": "Split Thickness Skin Graft Closure", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 8, "prompt": ": Hypergranulation tissue both on (8) ______", "sourcePage": 146, "choices": [], "kind": "blank", "answer": {"text": "Gluteal Folds On The Left Side", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 9, "prompt": ": one small area (9) ______                There is an external fixation", "sourcePage": 146, "choices": [], "kind": "blank", "answer": {"text": "Down Lower On The Calf Area", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 10, "prompt": ": on that (10) ______               The pin sites look clean.", "sourcePage": 146, "choices": [], "kind": "blank", "answer": {"text": "Comes Out Laterally On Left Thigh", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 11, "prompt": "associated with a (11) ______", "sourcePage": 146, "choices": [], "kind": "blank", "answer": {"text": "Sense Of Trauma To Right Posterior Leg", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 12, "prompt": "Further treatment : series of treatment with (12) ______                    of these areas till these are\nclosed", "sourcePage": 146, "choices": [], "kind": "blank", "answer": {"text": "Chemical Cauterization", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 13, "prompt": "edema, and recurrent leg venous ulcers. had a (13) ______                   for nonhealing right ankle\nstasis ulcer.", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Vascular Surgery", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 14, "prompt": "Past medical history : hypertension, (14) ______                  in 2016 for abdominal\nobstruction,", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Exploratory Laparotomy", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 15, "prompt": "obstruction, (15) ______                in 2017, chronic intermittent bipedal edema, venous insufficiency,\nchronic recurrent stasis ulcers.", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Cholecystectomy", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 16, "prompt": "Medications : Primaxin, (16) ______                  clonidine, furosemide, potassium chloride,\nlisinopril, metoprolol, ranitidine,", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Daptomycin", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 17, "prompt": "lisinopril, metoprolol, ranitidine, (17) ______               amlodipine, zinc sulfate, Lortab,\nmultivitamins with minerals.", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Colace", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 18, "prompt": "Diagnosis : There is (18) ______                  involving the distal calf of both legs. There is an open\nwound on the", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Hyperpigmentation", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 19, "prompt": "wound on the (19) ______                  measuring 9 x 5cm with minimal serous drainage. Periwound is\nhyperpigmented with a hint of", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Right Medial Malleolar Area", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 20, "prompt": "hyperpigmented with a hint of (20) ______               to the medial aspect, distal third of the right\nlower leg. There is warmth, but minimal tenderness on palpation of this area. There is also a\nwound on the right lateral malleolar area measuring 4 x 3 cm, another open wound on the left\nmedial malleolar area measuring 7 x 4 cm.", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Erythema Extending Proximally", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 21, "prompt": "medial malleolar area measuring 7 x 4 cm. (21) ______", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Wound Edges Are Poorly Defined", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 22, "prompt": ": Laboratory results show white blood cell count is 5.8 with (22) ______         H&H\n11.3/33.8, and platelet count 176,000. BUN and creatinine 9.2/0.52. Albumin 3.6, AST 25, ALT\n9, alk phos 87, and total bilirubin 0.6.", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "64% Neutrophils", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 23, "prompt": "Impression : multiple previous wound cultures positive for (23) ______                Enterococcus, and\nStenotrophomonas. Fevers.Right leg/ankle cellulitis. Chronic recurrent bilateral ankle venous\nulcers. Hypertension.", "sourcePage": 147, "choices": [], "kind": "blank", "answer": {"text": "Pseudomonas", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 24, "prompt": "Further diagnosis & Treatment : 2 sets of blood cultures. Injection with (24) ______", "sourcePage": 148, "choices": [], "kind": "blank", "answer": {"text": "Daptomycin And Primaxin Iv", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["c22616711cadf208e8c4191a42ddc1e45c37cd6d2f8832685cfcc5516dd6a37e"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [155]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-13-B", "label": "British Academy · Task 13 · Part B", "part": "B", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [148, 149, 150], "questions": [{"number": 25, "prompt": "You hear a discussion between a doctor and nurse about common types of neuropathic\npain.\n\nPain caused by an outbreak of shingles is;\n\nA. Pudendal neuralgia\n\nB. Postherpetic neuralgia\n\nC. Sciatica", "sourcePage": 148, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 26, "prompt": "You hear a discussion between a doctor and nurse about Bronchodilators Used to treat\nchronic obstructive pulmonary disease.\n\nWhich of the following bronchodilators works by blocking the neurotransmitter?\n\nA. Methylxanthines\n\nB. Anticholinergic\n\nC. Beta-agonists", "sourcePage": 149, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 27, "prompt": "You hear a discussion between a doctor and nurse about pancreatic neuroendocrine\ntumors.\n\nWhich of the following tumors is not malignant?\n\nA. Glucagonoma\n\nB. Gastrinoma\n\nC. Insulinoma", "sourcePage": 149, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 28, "prompt": "You hear a discussion between a doctor and nurse about melasma and different types\nof melasma.\n\nWhich of the following statements is correct?\n\nA. The epidermal melasma is characterized by presence of melanophages.\n\nB. Melasma appears only on face\n\nC. The dermal melasma is defined by the presence of excess melanin.", "sourcePage": 149, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 29, "prompt": "You hear a discussion between a doctor and nurse about possible causes of arthritis.\n\nWhich of following conditions is developed when the immune system dysfunctions?\n\nA. Osteoarthritis\n\nB. Reactive arthritis\n\nC. Rheumatoid arthritis", "sourcePage": 150, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 30, "prompt": "You hear a monologue of a physician on granulomas.\n\nWhich of the following statements is incorrect?\n\nA. The chronic activation of the metabolic sensor is responsible for the granulomas formation\n\nB. Granulomas are tissue nodules of immune cells that can protect many organs.\n\nC. Target Of Rapamycin inhibitors belong to a group of drugs that are licensed for clinical use\n\n                                            Part C\nIn this part of the test, you'll hear two different extracts. In each extract, you'll hear health\nprofessionals talking about specific aspects of their work.\n\nFor questions, 31 to 42 choose the answer (A, B, or C) which fits best according to what you\nhear. Complete the answers as you listen the audio.\n\nNow, look at extract one.", "sourcePage": 150, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["c22616711cadf208e8c4191a42ddc1e45c37cd6d2f8832685cfcc5516dd6a37e"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [155]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-13-C", "label": "British Academy · Task 13 · Part C", "part": "C", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [151, 152, 153, 154], "questions": [{"number": 31, "prompt": "What is an ileostomy?\n\nA. Removal of rectum in the surgery\n\nB. A procedure to dispose the stool\n\nC. Sewing of terminal ileum together", "sourcePage": 151, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 32, "prompt": "The last part of the small intestine is sewn together in;\n\nA. Proctocolectomy surgery\n\nB. Total Colectomy surgery\n\nC. J-Pouch surgery", "sourcePage": 151, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 33, "prompt": "Rectum is not removed in;\n\nA. Proctocolectomy\n\nB. Total colectomy\n\nC. Partial colectomy", "sourcePage": 152, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 34, "prompt": "Rectum is not removed in;\n\nA. Ileoanal Anastomosis\n\nB. Total colectomy\n\nC. Partial colectomy", "sourcePage": 152, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 35, "prompt": "The surgery that is not done for the patients with ulcerative colitis is;\n\nA. Partial colectomy\n\nB. Total colectomy\n\nC. Hemicolectomy", "sourcePage": 152, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 36, "prompt": "Which of the following surgeries doesn’t require a stoma?\n\nA. Partial colectomy\n\nB. Hemicolectomy\n\nC. Total colectomy", "sourcePage": 152, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 37, "prompt": "A surgery will be required in lateral malleolus fracture if;\n\nA. The fibula fracture is within 4 centimeters of the end of the bone\n\nB. The inner part of the ankle is injured\n\nC. The fracture involves lateral malleolus", "sourcePage": 153, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 155, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 38, "prompt": "Which of the following statements is correct?\n\nA. Medial malleolus is also called tibia\n\nB. Lateral malleolus fractures involve only tibia.\n\nC. An isolated lateral malleolus