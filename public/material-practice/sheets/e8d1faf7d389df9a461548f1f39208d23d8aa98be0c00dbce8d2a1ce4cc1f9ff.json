{"version": 1, "sourceSha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "documents": [{"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-e8f01a8f2e0b947ab9b9", "filename": "READING 18.pdf", "sha256": "e8f01a8f2e0b947ab9b9c9ba316bb4c3eb8cbf10919fe46b23f61906b7e2a9a9", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8f01a8f2e0b947ab9b9c9ba316bb4c3eb8cbf10919fe46b23f61906b7e2a9a9.pdf", "textPath": "imported-resources/text/e8f01a8f2e0b947ab9b9c9ba316bb4c3eb8cbf10919fe46b23f61906b7e2a9a9.json", "format": "pdf", "role": "paper"}], "units": [{"id": "e8f01a8f2e0b947a-p1", "label": "Part A · READING 18.pdf", "part": "A", "sourceSha256": "e8f01a8f2e0b947ab9b9c9ba316bb4c3eb8cbf10919fe46b23f61906b7e2a9a9", "pages": [1, 2, 3, 4, 5], "questions": [{"number": 1, "prompt": "Constant decrease in number of deaths due to the bacteria.\nAnswer________________.", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1485, "answer": {"text": "C", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "Need to evaluate the conditions and adhering to proper medical regime.\nAnswer________________.", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1574, "answer": {"text": "B", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "What is known to affect molecular assembly?\nAnswer__________________.", "sourcePage": 4, "choices": [], "kind": "question", "offset": 543, "answer": {"text": "Tetanus Toxin", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": ".Where toxin eventually will lead to?\nAnswer_______________.", "sourcePage": 4, "choices": [], "kind": "question", "offset": 619, "answer": {"text": "spinal cord or brainstem", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": ".What is the duration for the tetanus disease to become severe?\nAnswer_____________.", "sourcePage": 4, "choices": [], "kind": "question", "offset": 685, "answer": {"text": "incubation period", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "What is reported as not executed among patients?\nAnswer________________.", "sourcePage": 4, "choices": [], "kind": "question", "offset": 777, "answer": {"text": "Appropriate prophylaxis", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": "What is acceptable medication for small children?\nAnswer_______________.", "sourcePage": 4, "choices": [], "kind": "question", "offset": 858, "answer": {"text": "250 units of TIG", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 13, "prompt": "What does the tetanus toxoid booster confers?\nAnswer___________.", "sourcePage": 4, "choices": [], "kind": "question", "offset": 939, "answer": {"text": "passive immunity to the toxin", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": "What symptoms can be present when the toxin binds and interferes with the\nrelease of acetylcholine at the neuromuscular junction?\nAnswer_______________.", "sourcePage": 4, "choices": [], "kind": "question", "offset": 1012, "answer": {"text": "flaccid torpidity or immobility", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "TIG cannot neutralize the toxin once it__________ .", "sourcePage": 5, "choices": [], "kind": "question", "offset": 156, "answer": {"text": "irreversibly binds to tissues", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "The spores convert to their ____________ as they enter the body.", "sourcePage": 5, "choices": [], "kind": "question", "offset": 213, "answer": {"text": "vegetative forms and multiply", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 17, "prompt": "._____________ is reported to be the actual rate by which the death occurred.", "sourcePage": 5, "choices": [], "kind": "question", "offset": 283, "answer": {"text": "13.2%", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "____________ in appropriate ranges can be given for the children who are 7\nyears of age.", "sourcePage": 5, "choices": [], "kind": "question", "offset": 365, "answer": {"text": "Prophylactic doses", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "Reports showed that it can be possible to effectively deal with the disease\nwith ___________.", "sourcePage": 5, "choices": [], "kind": "question", "offset": 459, "answer": {"text": "3,000-6,000 units", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 20, "prompt": "With the presence of the ________________, the severity of the disease\nreaches to its highest degree.", "sourcePage": 5, "choices": [], "kind": "question", "offset": 558, "answer": {"text": "GABA and glycine", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "e8f01a8f2e0b947a-p6", "label": "Part B · PART B", "part": "B", "sourceSha256": "e8f01a8f2e0b947ab9b9c9ba316bb4c3eb8cbf10919fe46b23f61906b7e2a9a9", "pages": [6, 7, 8, 9, 10, 11], "questions": [{"number": 1, "prompt": "What information does this notice give?\nA How the splenectomy shall be performed for better results?\nB What does the operation involve?\nC Spleen and Splenectomy\nLaparoscopic splenectomy\nLaparoscopic splenectomy involves making four or more small (5 – 10 mm)\nincisions on the abdomen. Carbon dioxide gas is then pumped into the abdominal\ncavity to provide a space to operate in. A fiber-optic telescope and long\ninstruments are then inserted into the abdomen and the spleen is separated from the\nstomach, kidney and colon. The blood supply of the spleen is stapled across with a\nspecial device that secures the blood vessels. The spleen is then placed in a bag\ninside the abdomen. One of the small incisions is enlarged in order to deliver the\nspleen out of the abdomen in this bag.", "sourcePage": 6, "choices": ["A", "B", "C"], "kind": "question", "offset": 224}, {"number": 4, "prompt": "What is right about stem cells?\nA They create, recreate cells, replenish cell supply.\nB Develop and produce different kinds of cells.\nC Generate organs.\nStem cells are homogenous biological cells those cells can distinguish into\nspecialized cells and can split to produce more stem cells and it’s found into\nmulticellular organisms. In mammals, mostly there are two types; one is embryonic\nstem cells, which are isolated from the inner cell mass of blastocysts, and adult\nstem cells, which are located in various tissues. And the other one is adult stem\ncells and progenitor cells act as a repair system for the body, replenishing adult\ntissues. In a developing embryo, stem cells distinguish into all specified cells,\nectoderm, endoderm and mesoderm but also uphold and recover the regenerative\norgans, such as blood, skin, or intestinal tissues.\nThe three sources of autologous adult stem cells in humans are Bone marrow,\nAdipose tissue and Blood. Stem cells can also be taken from umbilical cord blood\njust after birth. Embryonic cell lines and autologous embryonic stem cells created\nthrough somatic cell nuclear transfer or dedifferentiation have also been proposed\nas assuring candidates for future therapies. Embryonic cell lines and autologous\nembryonic stem cells spawned through somatic cell nuclear transfer or\ndedifferentiation have also been intended as promising candidates for future\ntherapies.", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "B Develop and produce different kinds of cells.", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "What is correct as per the given notice?\nA The number of DM patients increased from 2011-12.\nB Exercise can be the best antidote for DM.\nC Deaths by DM increased from 2011-2014.\nDM - Overview\nAn estimated 23.4 million adults have diagnosed diabetes mellitus (DM), 7.6\nmillion have undiagnosed DM, and 81.6 million have prediabetes.\nAnalyses of high school–aged blood donors in 2011 to 2012 reported that 10% had\nprediabetes hemoglobin A1c levels and an additional 0.6% had hemoglobin A1c\n≥6.5%, the threshold endorsed to diagnose DM.\nA recent analysis of randomized controlled trials showed that exercise may exert\nits favorable effects by significantly improving glucose tolerance and insulin\nresistance. The benefits of exercise were further supported by a large intervention\nproject that showed that higher fitness was associated with a lower risk of incident\nDM regardless of demographic characteristics and baseline risk factors.\nIn 2014, there were 76488 DM-related deaths", "sourcePage": 10, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "B Exercise can be the best antidote for DM.", "source": {"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-e8d1faf7d389df9a4615", "filename": "READING ANSWERS 18.pdf", "sha256": "e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.pdf", "textPath": "imported-resources/text/e8d1faf7d389df9a461548f1f39208d23d8aa98be0c00dbce8d2a1ce4cc1f9ff.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "e8f01a8f2e0b947a-p12", "label": "Part C · READING 18.pdf", "part": "C", "sourceSha25