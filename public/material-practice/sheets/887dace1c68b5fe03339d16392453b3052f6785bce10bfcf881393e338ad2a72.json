{"version": 1, "sourceSha256": "887dace1c68b5fe03339d16392453b3052f6785bce10bfcf881393e338ad2a72", "documents": [{"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-887dace1c68b5fe03339", "filename": "READING 15.pdf", "sha256": "887dace1c68b5fe03339d16392453b3052f6785bce10bfcf881393e338ad2a72", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/887dace1c68b5fe03339d16392453b3052f6785bce10bfcf881393e338ad2a72.pdf", "textPath": "imported-resources/text/887dace1c68b5fe03339d16392453b3052f6785bce10bfcf881393e338ad2a72.json", "format": "pdf", "role": "paper"}], "units": [{"id": "887dace1c68b5fe0-p1", "label": "Part A · READING 15.pdf", "part": "A", "sourceSha256": "887dace1c68b5fe03339d16392453b3052f6785bce10bfcf881393e338ad2a72", "pages": [1, 2, 3, 4, 5, 6], "questions": [{"number": 1, "prompt": "One of the most common tests.\nAnswer _______________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 187, "answer": {"text": "C", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "The blockage or closing of a blood vessel or hollow organ.\nAnswer __________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 246, "answer": {"text": "B", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "Important factors that may influence the testing results.\nAnswer ____________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 329, "answer": {"text": "D", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": ".The condition that occurs in response to excessive itching or rubbing of the\nskin.\nAnswer _____________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 413, "answer": {"text": "A", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "Two different types of tests which help in diagnosing the disease condition.\nAnswer __________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 523, "answer": {"text": "B", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": ".The process or fact of irradiating or being irradiated.\nAnswer ___________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 624, "answer": {"text": "C", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 7, "prompt": ".Splitting or cracking of the skin.\nAnswer __________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 706, "answer": {"text": "A", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "Which test is known to be more helpful with respect to the determination of\nother irritants, which make it difficult to carry out other tests?\nAnswer __________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 152, "answer": {"text": "repeated open application test", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": "What are given orally or by injection and distribute throughout the body?\nAnswer ___________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 320, "answer": {"text": "Corticosteroids", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": "In which process do we apply the product two times?\nAnswer ______________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 420, "answer": {"text": "repeated open application test", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "What would be the outcome of the pre-prepared patch test, if there is dermatitis\non the back of the skin?\nAnswer ______________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 502, "answer": {"text": "false positive result", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": "What are the common precipitants of contact dermatitis?\nAnswer ____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 638, "answer": {"text": "cosmetic and sunscreen constituents", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 13, "prompt": ".What would be the outcome of the test, if the patient applies topical steroids\ntwo days prior to the test?\nAnswer _____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 722, "answer": {"text": "false negative result", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": ".What was the proportion of photoallergic incidents in suspected cases?\nAnswer __________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 858, "answer": {"text": "below 5%", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "___________ as the cumulative irritant is known to create more worsening\nconditions.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 156, "answer": {"text": "Chronic irritant contact dermatitis", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "The open patch is carried in order to examine the potentiality of the\n__________ or irritants.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 246, "answer": {"text": "sensitizers", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 17, "prompt": ".The chronic phase of a polymorphic pattern of inflammation is characterized\nby __________.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 346, "answer": {"text": "dryness, lichenification and fissuring", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "Carba mix is one of the _____________ in the standard series.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 442, "answer": {"text": "notable offenders", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "The standard method of testing involves the application of the___________.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 509, "answer": {"text": "photo allergen series", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 20, "prompt": "As per recommendations, allergens be subjected to ________________.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 589, "answer": {"text": "5 J cm2 UVA", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "887dace1c68b5fe0-p7", "label": "Part B · PART B", "part": "B", "sourceSha256": "887dace1c68b5fe03339d16392453b3052f6785bce10bfcf881393e338ad2a72", "pages": [7, 8, 9, 10, 11, 12], "questions": [{"number": 1, "prompt": "The notice talks about;\nA How blood clots occur.\nB Blood clot doesn`t form. (if the reaction doesn`t occur the way it should)\nC Blocking of clotting reaction.\nVKCFD\nInherited combined deficiency of the vitamin K dependent clotting factors is a very\nrare inherited bleeding disorder that is caused by a problem with clotting Factors\nII, VII, IX, and X. VKCFD can also be acquired later in life as a result of other\ndisorders, or certain medications such as the blood-thinning drug Coumadin.\nAcquired VKCFD is more common than the inherited form. Some newborn babies\nhave a temporary vitamin K deficiency, which can be treated with supplements at\nbirth. In order to continue the chain reaction of the coagulation cascade, these four\nfactors need to be activated in a chemical reaction that involves vitamin K.\nVKCFD is an autosomal recessive disorder, which means that both parents must\ncarry the defective gene in order to pass it on to their child. It also means that the\ndisorder affects both males and females.", "sourcePage": 7, "choices": ["A", "B", "C"], "kind": "question", "offset": 223, "answer": {"text": "B Blood clot doesn`t form. (if the reaction doesn`t occur the way it should)", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "What is correct?\nA All types of Factor I deficiency affect both males and females.\nB The fibrogen defect in impairment leads to disorder.\nC Genes can be both recessive or dominant.\nFactor I deficiency\nIt is an umbrella term for several related disorders in males and females, known as\ncongenital Fibrinogen defects. Afibrinogenemia (a lack of Fibrinogen) and\nhypofibrinogenemia (low levels of Fibrinogen) are quantitative defects, meaning\nthe amount of Fibrinogen in the blood is abnormal. Dysfibrinogenemia is a\nqualitative defect in which Fibrinogen does not work the way it should.\nHypodysfibrinogenemia is a combined defect that involves both low levels of\nFibrinogen and impaired function. Afibrinogenemia is an autosomal recessive\ndisorder, which means that both parents must carry the defective gene in order to\npass it on to their child. Hypofibrinogenemia, dysfibrinogenemia, and\nhypodysfibrinogenemia can be either recessive (both parents carry the gene) or\ndominant (only one parent carries and transmits the gene).", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A All types of Factor I deficiency affect both males and females.", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "What is referred to as weak muscle?\nA Chronic fatigue\nB Brachymesophalangy\nC Hypotonia\n2q37 deletion syndrome\nIt is a condition that can affect many parts of the body. This condition is\ncharacterized by hypotonia in infancy, mild to severe intellectual disability and\ndevelopmental delay, behavioral problems, characteristic facial features, and other\nphysical abnormalities.\nMost babies with 2q37 deletion syndrome are born with potentially chronic\nfatigue, which usually improves with age. About 25 percent of people with this\ncondition have autism, a developmental condition that affects communication and\nsocial interaction.\nThe characteristic facial features associated with 2q37 deletion syndrome include a\nprominent forehead, highly arched eyebrows, deep-set eyes, a flat nasal bridge, a\nthin upper lip, and minor ear abnormalities. Other features of this condition can\ninclude short stature, obesity, unusually short fingers and brachymesophalangy,\nsparse hair, heart defects, seizures, and an inflammatory skin disorder called\neczema. A few people with 2q37 deletion syndrome have a rare form of kidney\ncancer called Wilms tumor.", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "C Hypotonia", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "887dace1c68b5fe0-p13", "label": "Part C · READING 15.pdf", "part": "C", "sourceSha256": "887dace1c68b5fe03339d16392453b3052f6785bce10bfcf881393e338ad2a72", "pages": [13, 14, 15, 16, 17, 18, 19, 20], "questions": [{"number": 7, "prompt": "When a person becomes an adult, the cells divide only to;\nA Replace old cells\nB Replace dying cells\nC Repair injuries\nD All of the above", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 130, "answer": {"text": "D All of the above", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "Which of the following spreads through feces of a contaminated person;\nA Hepatitis A\nB Hepatitis B\nC Both\nD Can`t say", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 107, "answer": {"text": "A Hepatitis A", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "In the USA people go for liver transplantation due to;\nA Hepatitis A\nB Hepatitis B\nC Hepatitis C\nD All of the above", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 509, "answer": {"text": "C Hepatitis C", "source": {"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-1c6d03e3f36a129cde27", "filename": "READING ANSWERS 15.pdf", "sha256": "1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.pdf", "textPath": "imported-resources/text/1c6d03e3f36a129cde270a000a6e5f360351d91b0a88d52ae86f6738a9309921.json", "format": "pdf", "role": "answer-key"}], "passages": []}]}
