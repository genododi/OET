{"version": 1, "sourceSha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "documents": [{"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.pdf", "textPath": "imported-resources/text/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-bb9b7c303f8ade320d17", "filename": "READING 22.pdf", "sha256": "bb9b7c303f8ade320d17f4a77968f8856a1236fb4b48b50a3e8397609a619342", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb9b7c303f8ade320d17f4a77968f8856a1236fb4b48b50a3e8397609a619342.pdf", "textPath": "imported-resources/text/bb9b7c303f8ade320d17f4a77968f8856a1236fb4b48b50a3e8397609a619342.json", "format": "pdf", "role": "paper"}], "units": [{"id": "bb9b7c303f8ade32-p1", "label": "Part A · READING 22.pdf", "part": "A", "sourceSha256": "bb9b7c303f8ade320d17f4a77968f8856a1236fb4b48b50a3e8397609a619342", "pages": [1, 2, 3, 4, 5], "questions": [{"number": 1, "prompt": "In some cases, hernias may appear through different routes.\nAnswer_________", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1415, "answer": {"text": "B", "source": {"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.pdf", "textPath": "imported-resources/text/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "Relating to or denoting any disease or condition which arises spontaneously or\nfor which the cause is unknown.\nAnswer___________", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1496, "answer": {"text": "D", "source": {"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.pdf", "textPath": "imported-resources/text/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "Common reason why hernia appears.", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1630, "answer": {"text": "B", "source": {"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.pdf", "textPath": "imported-resources/text/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "What is the word used to describe systemic autoimmune diseases?\nAnswer____________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 502, "answer": {"text": ": Collagen disease", "source": {"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.pdf", "textPath": "imported-resources/text/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": ".How would you define lower hernias?\nAnswer ____________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 590, "answer": {"text": "Located inferomedially from the vascular bundle", "source": {"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.pdf", "textPath": "imported-resources/text/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": ".What is the terms which may mean relating to illness caused by medical\nexamination or treatment?\nAnswer____________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 651, "answer": {"text": "Iatrogenic", "source": {"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.pdf", "textPath": "imported-resources/text/b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "What is the word which means confined or imprison?\nAnswer___________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 773, "answer": {"text": "Incarcerated", "source": {"id": "offline-b7dc1e74e666dafd6abb", "filename": "READING ANSWERS 22.pdf", "sha256": "b7dc1e74e666dafd6abb0247a25b67ce9fa1285f9b1a707b9efbba33fe341dba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-1