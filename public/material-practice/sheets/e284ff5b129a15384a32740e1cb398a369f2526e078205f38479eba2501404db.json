{"version": 1, "sourceSha256": "e284ff5b129a15384a32740e1cb398a369f2526e078205f38479eba2501404db", "documents": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}, {"id": "offline-e284ff5b129a15384a32", "filename": "Task 12.ogg", "sha256": "e284ff5b129a15384a32740e1cb398a369f2526e078205f38479eba2501404db", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-5/e284ff5b129a15384a32740e1cb398a369f2526e078205f38479eba2501404db.ogg", "textPath": "imported-resources/text/e284ff5b129a15384a32740e1cb398a369f2526e078205f38479eba2501404db.json", "format": "ogg", "role": "recording"}], "units": [{"id": "british-academy-task-12-A", "label": "British Academy · Task 12 · Part A", "part": "A", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [132, 133, 134, 135], "questions": [{"number": 1, "prompt": "Patient’s description of symptoms: persistent mild weakness on the left leg and occasional\n(1) ______", "sourcePage": 132, "choices": [], "kind": "blank", "answer": {"text": "Numbness In The Left Hand", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 2, "prompt": ": had repeat (2) ______               and further imaging studies\nthat showed", "sourcePage": 132, "choices": [], "kind": "blank", "answer": {"text": "Carotid Dopplers", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 3, "prompt": "Past medical history : had a (3) ______                 and treated", "sourcePage": 132, "choices": [], "kind": "blank", "answer": {"text": "Cerebrovascular Accident And Treated", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 4, "prompt": "Medications : Plavix, aspirin, (4) ______                  lisinopril, hydrochlorothiazide, Lasix, insulin\nand", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Levothyroxine", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 5, "prompt": "and (5) ______", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Simvastatin", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 6, "prompt": "Physical examination : blood pressure 170/66, heart rate 66, (6) ______                    weight 254\npounds, temperature is 98.0.", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Respiratory Rate 16", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 7, "prompt": "Diagnosis : Normocephalic and atraumatic. No dry mouth. No palpable cervical lymph nodes.\n(7) ______                 are clear.", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Conjunctivae And Sclerae", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 8, "prompt": ": Cranial nerves shows mild decrease in the (8) ______", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Left Nasolabial Fold", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 9, "prompt": ": there is a (9) ______                in the left upper extremity.", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Mild Increased Tone", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 10, "prompt": "(10) ______                  The rest showed full strength.", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Hip Flexion Is 5-/5 On The Left", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 11, "prompt": "Impression : Status post cerebrovascular accident involving the right upper pons extending into\nthe (11) ______                 with a mild left hemiparesis, has been clinically stable with mild\nimprovement.", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Right Cerebral Peduncle", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 12, "prompt": "Further treatment : continue with (12) ______                  to reduce the risk of future strokes.\n patient should control blood sugar level, optimizing cholesterol and blood pressure control,\nregular exercise and healthy diet.", "sourcePage": 133, "choices": [], "kind": "blank", "answer": {"text": "Antiplatelet Therapy And Statin Therapy", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 13, "prompt": "No difficulty in swallowing. Getting (13) ______", "sourcePage": 134, "choices": [], "kind": "blank", "answer": {"text": "Loud Snoring", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 14, "prompt": ": (14) ______               at night times", "sourcePage": 134, "choices": [], "kind": "blank", "answer": {"text": "Mouth Breather", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 15, "prompt": ": gets about (15) ______               every year", "sourcePage": 134, "choices": [], "kind": "blank", "answer": {"text": "Four Bouts Of Tonsillitis", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 16, "prompt": "Past surgeries : had (16) ______", "sourcePage": 134, "choices": [], "kind": "blank", "answer": {"text": "Cholecystectomy", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 17, "prompt": "Family history of illness : sister has (17) ______               and other family members have cancer,\ndiabetes, heart disease, and hypertension.", "sourcePage": 134, "choices": [], "kind": "blank", "answer": {"text": "Ear Infection", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 18, "prompt": "Diagnosis : tongue, lip, floor of mouth are noted to be normal. (18) ______              does reveal\nvery large tonsils", "sourcePage": 135, "choices": [], "kind": "blank", "answer": {"text": "Oropharynx", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 19, "prompt": "very large tonsils (19) ______", "sourcePage": 135, "choices": [], "kind": "blank", "answer": {"text": "Measuring 3+ Or 4+", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 20, "prompt": "they were (20) ______               Mirror examination of", "sourcePage": 135, "choices": [], "kind": "blank", "answer": {"text": "Exophytic", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 21, "prompt": "Mirror examination of (21) ______                reveals some mild edema\nof the larynx. You have enlarged tonsils.", "sourcePage": 135, "choices": [], "kind": "blank", "answer": {"text": "Larynx", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 22, "prompt": "Impression : adenotonsillitis with (22) ______", "sourcePage": 135, "choices": [], "kind": "blank", "answer": {"text": "Adenotonsillar Hypertrophy", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 23, "prompt": "(23) ______                with mild acute\nlaryngitis. obesity", "sourcePage": 135, "choices": [], "kind": "blank", "answer": {"text": "Upper Respiratory Tract Infection", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 24, "prompt": "Further treatment : (24) ______", "sourcePage": 135, "choices": [], "kind": "blank", "answer": {"text": "Adenotonsillectomy", "page": 144, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b