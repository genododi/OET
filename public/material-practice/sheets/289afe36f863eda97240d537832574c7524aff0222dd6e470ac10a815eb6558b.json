": "Printed Benchmark answer key"}, "page": 1}}, {"part": "A", "number": 10, "prompt": "Not a candidate for ____", "sourcePage": 126, "group": "Extract 1", "choices": [], "kind": "blank", "answer": {"text": "Drug-induced jaundice", "source": {"assetPath": "benchmark/files/listening-key-17.pdf", "format": "pdf", "filename": "Printed Benchmark answer key"}, "page": 1}}, {"part": "A", "number": 11, "prompt": "Serum lipase & amylase (to eliminate ____", "sourcePage": 126, "group": "Extract 1", "choices": [], "kind": "blank", "answer": {"text": "Pancreatitis", "source": {"assetPath": "benchmark/files/listening-key-17.pdf", "format": "pdf", "filename": "Printed Benchmark answer key"}, "page": 1}}, {"part": "A", "number": 12, "prompt": "____ after results", "sourcePage": 126, "group": "Extract 1", "choices": [], "kind": "blank", "answer": {"text": "Imaging tests", "source": {"assetPath": "benchmark/files/listening-key-17.pdf", "format": "pdf", "filename": "Printed Benchmark answer key"}, "page": 1}}, {"part": "A", "number": 13, "prompt": "____ haematuria", "sourcePage": 126, "group": "Extract 2", "choices": [], "kind": "blank", "answer": {"text": "Visible", "source": {"assetPath": "benchmark/files/listening-key-17.pdf", "format": "pdf", "filename": "Printed Benchmark answer key"}, "page": 1}}, {"part": "A", "number": 14, "prompt": "Turned from ____ to dark red in last 24 hours", "sourcePage": 126, "group": "Extract 2", "choices": [], "kind": "blank", "answer": {"text": "Pinkish", "source": {"assetPath": "benchmark/files/listening-key-17.pdf", "format": "pdf", "filename": "Printed Benchmark answer key"}, "page": 1}}, {"part": "A", "number": 15, "prompt": "Difficulty ____", "sourcePage": 126, "group": "Extract 2", "choices": [], "kind": "blank", "answer": {"text": "Passing urine", "source": {"assetPath": "benchmark/files/listening-key-17.pdf", "format": "pdf", "filename": "Printed Benchmark answer key"}, "page": 1}}, {"part": "A", "number": 16, "prompt": "____ in urine", "so