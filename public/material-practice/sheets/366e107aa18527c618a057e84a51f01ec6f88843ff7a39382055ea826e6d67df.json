b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 18, "prompt": "experienced (18) ______                and dimming lights", "sourcePage": 110, "choices": [], "kind": "blank", "answer": {"text": "Intermittent Blurry Vision", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 19, "prompt": "Intact for (19) ______              shut site is clean, dry, and intact. There is a small 3 mm to 4 mm\nround scab", "sourcePage": 110, "choices": [], "kind": "blank", "answer": {"text": "Extraocular Movements", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 20, "prompt": "round scab (20) ______                 there is a", "sourcePage": 110, "choices": [], "kind": "blank", "answer": {"text": "Farther Down From The Shunt Reservoir", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 21, "prompt": "there is a (21) ______             there.", "sourcePage": 110, "choices": [], "kind": "blank", "answer": {"text": "Little Bit Of Dry Blood", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 22, "prompt": "Impression : worsening headaches are secondary to (22) ______", "sourcePage": 110, "choices": [], "kind": "blank", "answer": {"text": "Shunt Adjustment Back After An Mri", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 23, "prompt": "(23) ______                 and\nmigraine headaches", "sourcePage": 110, "choices": [], "kind": "blank", "answer": {"text": "PseudotumorCerebri Without Papilledema", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 24, "prompt": "Further diagnosis : to have another (24) ______                  to confirm the shunt back program to 90\nmmH2O.", "sourcePage": 111, "choices": [], "kind": "blank", "answer": {"text": "Skull X-ray", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["366e107aa18527c618a057e84a51f01ec6f88843ff7a39382055ea826e6d67df"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [118]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-10-B", "label": "British Academy · Task 10 · Part B", "part": "B", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [111, 112, 113], "questions": [{"number": 25, "prompt": "You hear a discussion between a doctor and nurse about different complications,\nfollowing heart attack.\n\nWhat happens when a cardiogenic shock occurs following heart attack?\n\nA. Heart beats irregularly.\n\nB. Blood pressure drops suddenly.\n\nC. Oxygen levels in the blood become too low.", "sourcePage": 111, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 26, "prompt": "You hear the discussion between two doctors about the impacts of acute kidney injury.\n\nUrine output of less than 0.5 milliliter per kilogram per hour for 14 hours indicates;\n\nA. Stage 1 of acute kidney injury\n\nB. Stage 3 of acute kidney injury\n\nC. Stage 2 of acute kidney injury", "sourcePage": 112, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 27, "prompt": "You hear a discussion between two doctors about acquired melanocytic nevi.\n\nPseudohorn cysts may be seen in;\n\nA. Dermal Nevi\n\nB. Junctional Nevi\n\nC. Compound Nevi", "sourcePage": 112, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 28, "prompt": "You hear a discussion between a doctor and nurse about amblyopia.\n\nIn which of the following conditions one eye has a refractive error?\n\nA. Anisometropic amblyopia\n\nB. Occlusion amblyopia\n\nC. Strabismic amblyopia", "sourcePage": 112, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 29, "prompt": "You hear a discussion between a doctor and nurse about miliaria.\n\nThe condition called sudamina occurs;\n\nA. When sweat moves from the ducts into the dermis.\n\nB. During sweat duct obstruction in the uppermost epidermis.\n\nC. During retention of sweat that moves into the middle layers of the epidermis and the upper\ndermis.", "sourcePage": 113, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 30, "prompt": "You hear a discussion between a doctor and nurse about different types of stents.\n\nWhich of the following stents is used to keep blood vessels outside the coronary arteries\nopen?\n\nA. Stent grafts\n\nB. Coronary stent\n\nC. Peripheral vascular stent\n\n                                            Part C\nIn this part of the test, you'll hear two different extracts. In each extract, you'll hear health\nprofessionals talking about specific aspects of their work.\n\nFor questions, 31 to 42 choose the answer (A, B, or C) which fits best according to what you\nhear. Complete the answers as you listen the audio.\n\nNow, look at extract one.", "sourcePage": 113, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["366e107aa18527c618a057e84a51f01ec6f88843ff7a39382055ea826e6d67df"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [118]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-10-C", "label": "British Academy · Task 10 · Part C", "part": "C", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [114, 115, 116, 117], "questions": [{"number": 31, "prompt": "What is always localized?\n\nA. Nevus uniuslateris\n\nB. Ichthyosis hystrix\n\nC. Nevus verrucosus", "sourcePage": 114, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 32, "prompt": "Which of these follow the lines of Blaschko?\n\nA. Keratinocytic epidermal nevus\n\nB. Nevus sebaceous\n\nC. Nevus comedonicus", "sourcePage": 114, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 33, "prompt": "Which can form blackheads?\n\nA. Keratinocytic epidermal\n\nB. Nevus comedonicus\n\nC. Becker nevus", "sourcePage": 115, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 34, "prompt": "Which of these is androgen--dependent?\n\nA. Becker nevus\n\nB. Nevus comedonicus\n\nC. Inflammatory linear verrucous epidermal nevus", "sourcePage": 115, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 35, "prompt": "Which one of these is not associated with brain?\n\nA. Nevus comedonicus\n\nB. Angora hair nevus\n\nC. Becker nevus", "sourcePage": 115, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 36, "prompt": "The epidermal nevi that form plaques is;\n\nA. Porokeratotic eccrine nevus\n\nB. Inflammatory linear verrucous epidermal nevus\n\nC. Acantholytic epidermal nevus", "sourcePage": 115, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 37, "prompt": "Which of the following conditions damages small arteries and blood vessels?\n\nA. Peripheral arterial disease\n\nB. Dyslipidemia\n\nC. Diabetes", "sourcePage": 116, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 118, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 38, "prompt": "Which of the following diseases develop fatty acid deposits?\n\nA. Peripheral arterial disease\n\nB. Diabetes\n\nC. High cholesterol", "sourcePage": 116, "choi