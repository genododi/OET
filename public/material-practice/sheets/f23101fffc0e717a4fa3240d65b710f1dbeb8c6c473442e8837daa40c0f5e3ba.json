65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": "According to paragraph 2, which one of the following statements is true about\nseborrheic eczema?\nA Infants may get this disease from their parents.\nB This disease occurs due to secretion of excess of oil by the oil glands, during\npregnancy.\nC There is no specific treatment available for this disease.\nD This disease can spread to various parts of the body as well.", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 376, "answer": {"text": "C There is no specific treatment available for this disease.", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": "According to paragraph 2, which word would mean: â€œto make a bad situation\nworseâ€•?\nA Provoke", "sourcePage": 15, "choices": ["A"], "kind": "question", "offset": 765, "answer": {"text": "C Aggravate", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": "In paragraph 3, â€œflake offâ€ may mean â€¦â€¦.\nA to begin to fall\nB to come off a surface in small, thin pieces\nC to become more obvious\nD to begin to develop, usually on the surface", "sourcePage": 16, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 241, "answer": {"text": "B to come off a surface in small, thin pieces", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "In paragraph 1, what does the word â€œsubjectiveâ€• mean?\nA Something that requires fact\nB Illusory\nC Not easy to understand and explain\nD Something that can`t be determined or measured by tests", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 0, "answer": {"text": "D Something that can`t be determined or measured by tests", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "According to paragraph 1, what do some doctors feel about fibromyalgia?\nA It is a serious condition\nB It is a condition that is difficult to examine\nC It is a condition that is not real\nD It is a condition which every patient finds difficult to accept", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 219, "answer": {"text": "C It is a condition that is not real", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 17, "prompt": "According to paragraph 2, which one of the following statements is true?\nA Doctors of the 21st century know more about this condition.\nB Doctors believe change in lifestyle can be more effective in managing the\ncondition.\nC Doctors are still finding effective ways of treating this condition.\nD Researchers are working on developing new drugs for the treatment of this\ncondition.", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 495, "answer": {"text": "C Doctors are still finding effective ways of treating this condition.", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 20, "prompt": "According to paragraph 4, which one of the following statements is true?\nA Doctors first check trigger points to identify the problem of fibromyalgia.\nB Fibromyalgia is a genetic disorder\nC Fibromyalgia is hard to detect\nD Doctors in the 21st century know more about how fibromyalgia occurs", "sourcePage": 20, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 286, "answer": {"text": "B Fibromyalgia is a genetic disorder", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 21, "prompt": "According to paragraph 4, which one of the following statements is true?\nA Fibromyalgia is common among people who suffer from emotional trauma.\nB Stress is also one of the factors that often leads to fibromyalgia.\nC People who suffered long-term illness can develop fibromyalgia.\nD none of the above", "sourcePage": 20, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 601, "answer": {"text": "A Fibromyalgia is common among people who suffer from emotional trauma.", "source": {"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-f23101fffc0e717a4fa3", "filename": "READING ANSWERS 19.pdf", "sha256": "f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.pdf", "textPath": "imported-resources/text/f23101fffc0e717a4fa3240d65b710f1dbeb8c6c473442e8837daa40c0f5e3ba.json", "format": "pdf", "role": "answer-key"}], "passages": []}]}
