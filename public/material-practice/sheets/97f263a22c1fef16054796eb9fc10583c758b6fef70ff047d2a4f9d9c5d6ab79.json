ourceSha256": "5dcb82de4427f5a101e48796d6e57544f6d2241e0e5852a689ce1f200f74e4f0", "pages": [3, 4, 5], "questions": [], "skills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-84a9533b82e13ebe8cc8", "filename": "Listening-Sample-Test-2-Answer-Key.pdf", "sha256": "84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.pdf", "textPath": "imported-resources/text/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "5dcb82de4427f5a1-p6", "label": "Part B · Listening-Sample-Test-2-Question-Paper.pdf", "part": "B", "sourceSha256": "5dcb82de4427f5a101e48796d6e57544f6d2241e0e5852a689ce1f200f74e4f0", "pages": [6, 7], "questions": [], "skills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-84a9533b82e13ebe8cc8", "filename": "Listening-Sample-Test-2-Answer-Key.pdf", "sha256": "84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.pdf", "textPath": "imported-resources/text/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "5dcb82de4427f5a1-p8", "label": "Part C · Listening-Sample-Test-2-Question-Paper.pdf", "part": "C", "sourceSha256": "5dcb82de4427f5a101e48796d6e57544f6d2241e0e5852a689ce1f200f74e4f0", "pages": [8, 9, 10, 11, 12], "questions": [{"number": 31, "prompt": "What does Sandra Morton see as the main aim in her work?\nM\nA   to inform patients about the different treatments on offer\nB   to publicise the availability of tests for the condition\nA\nC   to raise awareness of the symptoms of the illness\nS", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 1220, "answer": {"text": "C      to raise awareness of the symptoms of the illness", "source": {"id": "offline-84a9533b82e13ebe8cc8", "filename": "Listening-Sample-Test-2-Answer-Key.pdf", "sha256": "84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.pdf", "textPath": "imported-resources/text/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 32, "prompt": "When Harry was offered a routine health check at his local surgery, he initially\nA   resisted the idea due to his wife’s experience.\nB   felt that he was too ﬁt and well to be in need of it.\nC   only agreed to attend because his doctor advised him to.", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 1653, "answer": {"text": "B      felt that he was too fit and well to be in need of it.", "source": {"id": "offline-84a9533b82e13ebe8cc8", "filename": "Listening-Sample-Test-2-Answer-Key.pdf", "sha256": "84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.pdf", "textPath": "imported-resources/text/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 34, "prompt": "What was Harry’s response to being diagnosed with prostate cancer?\nA    He found himself reacting in a way he hadn’t anticipated.\nB    He was unconvinced by the prognosis he was given.\nC    He immediately researched treatment options online.", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A      He found himself reacting in a way he hadn’t anticipated.", "source": {"id": "offline-84a9533b82e13ebe8cc8", "filename": "Listening-Sample-Test-2-Answer-Key.pdf", "sha256": "84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.pdf", "textPath": "imported-resources/text/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 35, "prompt": "What typical patient response to the illness does Sandra mention?\nE\nA    an unwillingness to commence appropriate medication\na failure to seek advice regarding different treatment options\nL\nB\nC    a reluctance to talk about the embarrassing aspects of treatment\n36.\nP\nSandra believes that community follow-up clinics are important because they\nA\nM\noffer patients more personal aftercare.\nA\nB    are proven to be less traumatic for patients.\nS\nC    provide rapid treatment for patients developing new symptoms.\nNow look at extract two.\nSAMPLE\n[CANDIDATE NO.] LISTENING QUESTION PAPER 09/12", "sourcePage": 9, "choices": ["A", "C", "B"], "kind": "question", "offset": 309, "answer": {"text": "C      a reluctance to talk about the embarrassing aspects of treatment", "source": {"id": "offline-84a9533b82e13ebe8cc8", "filename": "Listening-Sample-Test-2-Answer-Key.pdf", "sha256": "84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.pdf", "textPath": "imported-resources/text/84a9533b82e13ebe8cc8ad6f2a63381b7d1aeede19d8bd4f33cd2eef9cfa52a9.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-84a9533b82e13ebe8cc8", "filename": "Listening-Sample-Test-2-Answe