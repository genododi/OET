{"version": 1, "sourceSha256": "c055f13a7ffdf8ba5f2d0bb814ff2cb8b0ef875ed5bba614324b5085e7ed9f85", "documents": [{"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-c055f13a7ffdf8ba5f2d", "filename": "READING 5.pdf", "sha256": "c055f13a7ffdf8ba5f2d0bb814ff2cb8b0ef875ed5bba614324b5085e7ed9f85", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/c055f13a7ffdf8ba5f2d0bb814ff2cb8b0ef875ed5bba614324b5085e7ed9f85.pdf", "textPath": "imported-resources/text/c055f13a7ffdf8ba5f2d0bb814ff2cb8b0ef875ed5bba614324b5085e7ed9f85.json", "format": "pdf", "role": "paper"}], "units": [{"id": "c055f13a7ffdf8ba-p1", "label": "Part A · READING 5.pdf", "part": "A", "sourceSha256": "c055f13a7ffdf8ba5f2d0bb814ff2cb8b0ef875ed5bba614324b5085e7ed9f85", "pages": [1, 2, 3, 4, 5, 6], "questions": [{"number": 1, "prompt": ".EAAs obtained from muscle protein will undergo oxidation.\nAnswer_________________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 188, "answer": {"text": "C", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": ".Are BCAAs anabolic in the postabsorptive state?\nAnswer______________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 284, "answer": {"text": "D", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": ".Muscle protein turnover and dietary protein intake.\nAnswer____________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 367, "answer": {"text": "B", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": ".The rate of muscle protein synthesis will always be lesser than rate of\nmuscle protein breakdown.\nAnswer_____________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 452, "answer": {"text": "C", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": ".Addition of BCAAs can enhance protein synthesis.\nAnswer _____________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 590, "answer": {"text": "A", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": ".Synthesis of protein could have been curbed by presence of EAA.\nAnswer __________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 675, "answer": {"text": "A", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 7, "prompt": ".When EAAs are in large quantity protein synthesis enhances.\nAnswer ___________", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 775, "answer": {"text": "B", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": ".What happens with the consumption of BCAA supplements?\nAnswer ____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 154, "answer": {"text": "anabolic state enhances", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": ".What will drive anabolic state more theoretically?\nAnswer_____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 244, "answer": {"text": "inhibition of muscle protein breakdown", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": ".What are the limitations of Kobayashi?\nAnswer _____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 330, "answer": {"text": "increase in muscle protein synthesis", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": ".What can lead to 15% increase in the rate of muscle protein synthesis?\nAnswer______________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 406, "answer": {"text": "BCCA Consumption", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": "Muscle protein synthesis often get limited by the lack of availability of?\nAnswer______________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 513, "answer": {"text": "EAAs", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 13, "prompt": "What gets stimulated with induction of BCAAs?\nAnswer _____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 623, "answer": {"text": "muscle protein synthesis", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": "What is requisite for the production of muscle protein?\nAnswer ______________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 708, "answer": {"text": "9 EAAs", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "______________ were failed to measure the effects of BCAAs alone.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 158, "answer": {"text": "Garlick and Grant", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": ".EAA which is needed for muscle protein synthesis can be obtained from\nincreased ____________", "sourcePage": 6, "choices": [], "kind": "question", "offset": 229, "answer": {"text": "plasma concentrations", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 17, "prompt": "EAAs derived from________________ which are not added to the muscle\nprotein will be released into plasma.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 327, "answer": {"text": "muscle protein breakdown", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "Body doesn`t have the capability to produce ________________", "sourcePage": 6, "choices": [], "kind": "question", "offset": 438, "answer": {"text": "EAAs", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "When there is curtailment of the amount of EAAs into plasma by 50% and\nmore, there will be reduction\nIn _________________", "sourcePage": 6, "choices": [], "kind": "question", "offset": 504, "answer": {"text": "plasma", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 20, "prompt": "When rate of muscle protein synthesis increases or goes above the levels of\nmuscle protein\nBreakdown, ________________ may get enhanced.", "sourcePage": 6, "choices": [], "kind": "question", "offset": 632, "answer": {"text": ": muscle mass", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "c055f13a7ffdf8ba-p7", "label": "Part B · PART B", "part": "B", "sourceSha256": "c055f13a7ffdf8ba5f2d0bb814ff2cb8b0ef875ed5bba614324b5085e7ed9f85", "pages": [7, 8, 9, 10, 11, 12], "questions": [{"number": 1, "prompt": ".What is correct about the heartbeat sensor?\nA This signal in form of DC signal is related to the total amount of blood\nB The signal in form of AC will conjoin with the DC signal\nC The detector output is in form of electrical signal and is proportional to the\nheartbeat rate.\nHeartbeat Sensor\nThe basic heartbeat sensor consists of a light emitting diode and a detector like a\nlight detecting resistor or a photodiode. The heartbeat pulses cause a variation in\nthe flow of blood to different regions of the body. When a tissue is illuminated by\nthe light source, i.e., light emitted by the led, it either reflects (a finger tissue) or\ntransmits the light (earlobe). Some of the light is absorbed by the blood and the\ntransmitted or the reflected light is received by the light detector. The amount of\nlight absorbed depends on the blood volume in that tissue. The result as shown by\ndetector based on the electrical signal will be as per the changes in the heartbeat\nrate.\nThis signal is actually a DC signal relating to the tissues and the blood volume and\nthe AC component synchronous with the heartbeat and caused by pulsatile changes\nin arterial blood volume is superimposed on the DC signal. Thus the major\nrequirement is to isolate that AC component as it is of prime importance.", "sourcePage": 7, "choices": ["A", "B", "C"], "kind": "question", "offset": 223, "answer": {"text": "C The detector output is in form of electrical signal and is proportional to the", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": ".What is correct about ICU Sedation?\nA Fear and anxiety are common.\nB Necessitate neurological examination.\nC More than 69% of patients in an ICU were found to be inappropriately\nsedated.\nICU Sedation\nComplications of over-sedation            Complications of under-sedation\nIncreased time on mechanical\nventilation.\nIncreased length of stay in ICU and/or\nFear, anxiety and agitation. Unpleasant\nhospital. An additional cost of care.\nrecall. Medical device removal. An\nNeed for additional diagnostic testing.\nadditional costs. Increased nursing time\nIncreased risk of delirium. Decreased\nwound healing and GI motility.\nImpaired reliability of neurological\nexaminations", "sourcePage": 12, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "C More than 69% of patients in an ICU were found to be inappropriately", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "c055f13a7ffdf8ba-p13", "label": "Part C · READING 5.pdf", "part": "C", "sourceSha256": "c055f13a7ffdf8ba5f2d0bb814ff2cb8b0ef875ed5bba614324b5085e7ed9f85", "pages": [13, 14, 15, 16, 17, 18, 19, 20], "questions": [{"number": 7, "prompt": "According to paragraph 1, what is true about cauliflower ear?\nA Cauliflower ear results from repetitive blows to the ear\nB Cauliflower ear occurs due to clotting of the blood on the bruised area\nC Cauliflower ear occurs because the ear skin is stripped and is not able to\nsupply oxygen to the cartilage and surrounding area that is badly hit\nD Cauliflower ear may often lead to distortion of the shape of the ear.", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 113, "answer": {"text": "D Cauliflower ear may often lead to distortion of the shape of the ear.", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "In paragraph 1, what does the word contusion imply?\nA Being hit by the opponent\nB A bruise\nC A serious injury\nD A very painful blow", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 546, "answer": {"text": "B A bruise", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": "According to paragraph 2, which one of the following statements is not true?\nA Once infection grows, it can bring changes in the shape of the ear.\nB Athletes often do not pay attention to injuries to their ear which may later\ndevelop into cauliflower ear.\nC The occurrence of this cauliflower ear among athletes is very common.\nD It is suggested that sports should be played using all necessary safety\nequipment.", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 697, "answer": {"text": "D It is suggested that sports should be played using all necessary safety", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": "What is headgear in passage 2?\nA Covering of the head\nB Soft helmet\nC Boxing helmet\nD A metal hat used for protection in games like rugby", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1129, "answer": {"text": "A Covering of the head", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "According to paragraph 3, what is the first step towards injury treatment and\nmanagement?\nA Ice should be applied on the bruised ear\nB Ice and a head wrap should be applied\nC Drainage and compression\nD Splinting", "sourcePage": 16, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 0, "answer": {"text": "B Ice and a head wrap should be applied", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": "According to paragraph 4, in the drainage and compression method, the doctor\nwould;\nA Remove blood from the ear.\nB Try to connect the skin with the cartilage.\nC Apply pressure on the affected area.\nD Stitch the ruptured parts.", "sourcePage": 16, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 235, "answer": {"text": "A Remove blood from the ear.", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": "What does paragraph 5 indicate?\nA Preventive measures for cauliflower ear.\nB What experts suggest athletes should do.\nC The importance of wearing headgear for sports.\nD Advice from experts at Nano Hospital Sports Medicine in the US.", "sourcePage": 16, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 714, "answer": {"text": "A Preventive measures for cauliflower ear.", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "In paragraph 1, the word interim may mean;\nA Severe\nB Transient\nC May last for a longer time\nD Often permanent", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 25, "answer": {"text": "B Transient", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "According to paragraph 1, what is not true about rosacea?\nA Rosacea is a condition in which the redness of skin may last only for a short\nperiod of time.\nB Rosacea is a condition where the patient can feel the warmth around the\naffected skin.\nC Rosacea is common among women living in the US.\nD Scaling is a feature that is often connected with rosacea.", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 156, "answer": {"text": "A Rosacea is a condition in which the redness of skin may last only for a short", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "According to paragraph 2, what is true about rosacea?\nA The symptoms of rosacea vary depending on the subtypes.\nB Each and every type of rosacea shows a specific set of features.\nC It is possible that one type of rosacea may show features of other advanced\ntypes of rosacea.\nD None of the above", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 789, "answer": {"text": "C It is possible that one type of rosacea may show features of other advanced", "source": {"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "What is the central idea presented in paragraph 3?\nA How the skin reacts to rosacea\nB What does rosacea look like?", "sourcePage": 19, "choices": ["A", "B"], "kind": "question", "offset": 1104}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-bda9dbe5de27b806b9e5", "filename": "READING ANSWERS 5.pdf", "sha256": "bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.pdf", "textPath": "imported-resources/text/bda9dbe5de27b806b9e547bd460f6b7365280b18d5b33d2680a42e3cb0d6e60e.json", "format": "pdf", "role": "answer-key"}], "passages": []}]}
