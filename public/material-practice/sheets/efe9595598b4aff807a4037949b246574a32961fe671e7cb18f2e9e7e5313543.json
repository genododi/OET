kills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [{"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper", "pages": [140]}], "passages": []}, {"id": "efe9595598b4aff8-p141", "label": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "part": null, "sourceSha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "pages": [141, 142], "questions": [{"number": 35, "prompt": "How much farther before we arrive in Santa Fe?", "sourcePage": 141, "choices": [], "kind": "question", "offset": 1054}, {"number": 37, "prompt": "In the end, we had to decide between a minivan and a station wagon\nas our second car.", "sourcePage": 141, "choices": [], "kind": "question", "offset": 1184}, {"number": 42, "prompt": "Mother, may I go to the movies with Ashton this afternoon?", "sourcePage": 141, "choices": [], "kind": "question", "offset": 1477}, {"number": 5, "prompt": "In the newspaper, an interesting article appeared.", "sourcePage": 142, "choices": [], "kind": "question", "offset": 899, "answer": {"text": "If our staff members don’t quit picking at each other, we will not meet", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 143}}, {"number": 9, "prompt": "In the gutter, I found a shiny new dime.", "sourcePage": 142, "choices": [], "kind": "question", "offset": 1162, "answer": {"text": "Nora, of all the candidates who are running, is the best. (or are running)", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 143}}, {"number": 7, "prompt": "If all is lost, why am I still playing?", "sourcePage": 142, "choices": [], "kind": "question", "offset": 1911, "answer": {"text": "Neither she nor they were willing to predict the election results.", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 143}}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [{"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper", "pages": [143, 144]}], "passages": []}, {"id": "efe9595598b4aff8-p145", "label": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "part": null, "sourceSha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "pages": [145], "questions": [{"number": 6, "prompt": "Can you go with us?", "sourcePage": 145, "choices": [], "kind": "question", "offset": 161}, {"number": 3, "prompt": "If you don’t mind my asking, why are you so angry?", "sourcePage": 145, "choices": [], "kind": "question", "offset": 1215}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [], "passages": []}, {"id": "efe9595598b4aff8-p146", "label": "122   The Blue Book of Grammar and Punctuation", "part": null, "sourceSha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "pages": [146], "questions": [{"number": 18, "prompt": "When the horse kicked its legs, the rider bounced off and landed in the\nlake.", "sourcePage": 146, "choices": [], "kind": "question", "offset": 863, "answer": {"text": "Give the information to whoever requests it.", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 147}}, {"number": 1, "prompt": "Who is your closest friend?", "sourcePage": 146, "choices": [], "kind": "question", "offset": 1214, "answer": {"text": "We intend to notify whoever ranks highest on the list.", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 147}}, {"number": 2, "prompt": "Whom do you bank with? OR With whom do you bank?", "sourcePage": 146, "choices": [], "kind": "question", "offset": 1262, "answer": {"text": "These are the sign language interpreters whom I feel you should", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 147}}, {"number": 3, "prompt": "Who do you think will win the award?", "sourcePage": 146, "choices": [], "kind": "question", "offset": 1331}, {"number": 8, "prompt": "Who was that in the clown costume?", "sourcePage": 146, "choices": [], "kind": "question", "offset": 1676, "answer": {"text": "The therapist will talk with whoever needs her help.", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 147}}, {"number": 13, "prompt": "Of whom were you speaking?", "sourcePage": 146, "choices": [], "kind": "question", "offset": 1989, "answer": {"text": "Sometimes it is the one who does the most work who is the least tired.", "source": {"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper"}, "page": 147}}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [{"id": "offline-efe9595598b4aff807a4", "filename": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "sha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.pdf", "textPath": "imported-resources/text/efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543.json", "format": "pdf", "role": "paper", "pages": [147, 148, 149]}], "passages": []}, {"id": "efe9595598b4aff8-p150", "label": "The_Blue_Book_of_Grammar_and_Punctuation.pdf", "part": null, "sourceSha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "pages": [150], "questions": [{"number": 19, "prompt": "If you won’t tell me your secret now, then when will you tell me?", "sourcePage": 150, "choices": [], "kind": "question", "offset": 1176}, {"number": 3, "prompt": "Where did you get this?", "sourcePage": 150, "choices": [], "kind": "question", "offset": 1481}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "