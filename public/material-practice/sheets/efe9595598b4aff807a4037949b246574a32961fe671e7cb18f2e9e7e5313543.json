mber": 8, "prompt": "Is that book your’s?", "sourcePage": 124, "choices": [], "kind": "question", "offset": 1467}, {"number": 19, "prompt": "‘‘Would you like to accompany me’’? he asked?", "sourcePage": 125, "choices": [], "kind": "question", "offset": 91}, {"number": 25, "prompt": "He asked if he could be excused?", "sourcePage": 125, "choices": [], "kind": "question", "offset": 432}, {"number": 35, "prompt": "‘‘What does it take to become a licensed architect,’’ she asked?", "sourcePage": 125, "choices": [], "kind": "question", "offset": 974}, {"number": 11, "prompt": "Mae said ‘‘Why don’t you come up and see me sometime?’’", "sourcePage": 126, "choices": [], "kind": "question", "offset": 936}, {"number": 12, "prompt": "You said that I could go, didn’t you?", "sourcePage": 126, "choices": [], "kind": "question", "offset": 1012}, {"number": 14, "prompt": "He seems to be such a lonely, quiet man doesn’t he?", "sourcePage": 126, "choices": [], "kind": "question", "offset": 1150}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [], "passages": []}, {"id": "efe9595598b4aff8-p127", "label": "Quizzes        103", "part": null, "sourceSha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "pages": [127, 128, 129], "questions": [{"number": 12, "prompt": "What a delicious, appetizing meal!", "sourcePage": 127, "choices": [], "kind": "question", "offset": 256}, {"number": 7, "prompt": "Did you John eat my cake?", "sourcePage": 128, "choices": [], "kind": "question", "offset": 2129}, {"number": 8, "prompt": "Did John eat my cake?", "sourcePage": 128, "choices": [], "kind": "question", "offset": 2175}, {"number": 9, "prompt": "Did his friend John eat my cake?", "sourcePage": 128, "choices": [], "kind": "question", "offset": 2217}, {"number": 10, "prompt": "Did John his friend eat the cake?", "sourcePage": 129, "choices": [], "kind": "question", "offset": 16}, {"number": 1, "prompt": "He wanted to know when you will be here?", "sourcePage": 129, "choices": [], "kind": "question", "offset": 1545}, {"number": 3, "prompt": "‘‘Is it almost over?’’ he asked?", "sourcePage": 129, "choices": [], "kind": "question", "offset": 1677}, {"number": 5, "prompt": "The song asks, ‘‘Would you like to swing on a star’’?", "sourcePage": 129, "choices": [], "kind": "question", "offset": 1785}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [], "passages": []}, {"id": "efe9595598b4aff8-p130-extract1", "label": "106   The Blue Book of Grammar and Punctuation", "part": null, "sourceSha256": "efe9595598b4aff807a4037949b246574a32961fe671e7cb18f2e9e7e5313543", "pages": [130], "ranges": [{"page": 130, "start": 0, "end": 767}], "questions": [{"number": 9, "prompt": "‘‘May I have a rain check on that lunch’’? I asked.", "sourcePage": 130, "choices": [], "kind": "question", "offset": 49}, {"number": 11, "prompt": "Bernard said, Waldo asked, ‘‘Who took my pencil sharpener?’’", "sourcePage": 130, "choices": [], "kind": "question", "offset": 295}, {"number": 12, "prompt": "‘‘May I see your I.D. card,’’ the clerk asked?", "sourcePage": 130, "choices": [], "kind": "question", "offset": 376}, {"number": 3, "prompt": "Sandi asked, ‘‘Did Jeri say, ‘I am pregnant?’’’", "sourcePage": 130, "choices": [], "kind": "question", "offset": 949}, {"number": 6, "prompt": "Did he ask? ‘‘Where are my keys’’?", "sourcePage": 130, "choices": [], "kind": "question", "offset": 1151}, {"number": 7, "prompt": "Harry needs to know if he can count on you?", "sourcePage": 130, "choices": [], "kind": "question", "offset": 1206}, {"number": 10, "prompt": "It wouldn’t surprise me if he quit his job?", "sourcePage": 130, "choices": [], "kind": "question", "offset": 1453}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [], "passages": []}, {"id": "efe9595598b4aff8-p130-extract2", "label": "1. ‘‘Correct me if I am wrong.’’ She said.", "part"