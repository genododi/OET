estions": [{"number": 25, "prompt": "You hear two doctors discuss the transfer of care for a patient.\nThe patient’s CURB-65 score means that he will\n(A) be transferred from the Emergency Department.\n(B) receive additional medication and treatment.\n(C) be treated as an out-patient.", "sourcePage": 31, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 26, "prompt": "You hear a speech pathologist talking to the wife of a patient who has\nrecently suffered a stroke.\nWhat does she want to know about her husband’s condition?\n(A) how long it will take him to make a full recovery\n(B) whether his communication issues will improve\n(C) what she can do to speed the healing process", "sourcePage": 31, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 27, "prompt": "You hear a trainee doctor asking a senior colleague about chest tubes.\nWhat is the senior colleague doing?\n(A) explaining how to use them correctly\n(B) recommending an alternative to them\n(C) demonstrating what can go wrong with them", "sourcePage": 32, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 28, "prompt": "You hear a pharmacist talking to a customer about pain relief.\nWhat has the customer been misinformed about?\n(A) the stock of medication in the pharmacy\n(B) the usefulness of a type of pain relief\n(C) the availability of a medicine", "sourcePage": 32, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 29, "prompt": "You hear a trainee nurse receiving feedback from his tutor\nWhat does she explain?\n(A) listening to a patient’s concerns is essential\n(B) how to become more self-assured when interacting with\npatients\n(C) the importance of providing adequate emotional support to\npatients", "sourcePage": 32, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 30, "prompt": "You hear two doctors planning their patient-care schedule\nWhat is their priority?\n(A) identifying the patients at greatest risk\n(B) dealing with patients who need tests arranging\n(C) ensuring that all patients have key documentation", "sourcePage": 32, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["c234c69b0e19d27814eb5cbccb44523e86cf95a5638084d7dba984e6c4c219bf"], "answerSources": [], "matchEvidence": "Exact original recording SHA-256 in the verified Jahshan collection"}, {"id": "jahshan-1mJv8YSu76ZmykU6mcGst23CuHUNGjwRm-C-0", "label": "Jahshan set 2 · Part C", "part": "C", "sourceSha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "pages": [33, 34, 35, 36], "questions": [{"number": 31, "prompt": "Dr Leach says that during the onset of meningitis, many patients\n(A) do not realise they are unwell.\n(B) mistake the illness for something else.\n(C) experience life-threatening symptoms.", "sourcePage": 33, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 32, "prompt": "Dr Leach says that meningitis is common in college students because of\ntheir\n(A) poor hygiene habits.\n(B) proximity to new people.\n(C) weakened immune systems.", "sourcePage": 33, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 33, "prompt": "Why does Dr Leach say the patient didn’t seek treatment sooner?\n(A) He was unsure of what to do.\n(B) He didn’t think he needed treatment.\n(C) He was trying to finish his assignments.", "sourcePage": 34, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 34, "prompt": "Dr Leach began treating for meningitis before receiving the spinal fluid\nresults because\n(A) the illness progresses rapidly.\n(B) the treatment is the same for all causes.\n(C) the test results did not affect the diagnosis.", "sourcePage": 34, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 35, "prompt": "Dr Leach explains that meningitis is more likely to cause long term\nafter-effects if\n(A) it is not accurately diagnosed.\n(B) patients do not seek treatment quickly.\n(C) reactions to the virus are extremely severe.", "sourcePage": 34, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 36, "prompt": "Dr Leach advises those who think they may be infected with meningitis\nto\n(A) get vaccinated at the earliest opportunity.\n(B) avoid people who may be suffering from the virus.\n(C) take precautions to prevent others from becoming ill.\n\nQUESTIONS 37 TO 42\nExtract 2: Questions 37 to 42\nYou hear a presentation given by a clinical psychiatrist called Dr\nEvalina Houghton about agitated patients in an emergency setting.", "sourcePage": 34, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 37, "prompt": "Dr Houghton says that patients in the ED are more likely to be agitated\nas they are likely to\n(A) suffer from untreated health problems.\n(B) have been given bad news recently.\n(C) require medical help frequently.", "sourcePage": 35, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 38, "prompt": "Dr Houghton explains that creating space between the patient and the\nprovider\n(A) enables both parties to remain calm.\n(B) encourages the patient to exit the room.\n(C) reduces the likelihood of the provider being injured.", "sourcePage": 35, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 39, "prompt": "Why does Dr Houghton encourage providers to speak slowly?\n(A) to ensure the patient understands what is being said\n(B) to give other members of staff time to prepare\n(C) to give the patient an opportunity to speak", "sourcePage": 36, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 40, "prompt": "What approach does Dr Houghton suggest for patients suffering from\ndelusions?\n(A) agree with the patient completely\n(B) acknowledge the patient’s emotions\n(C) explain why their delusions are false", "sourcePage": 36, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 41, "prompt": "Dr Houghton suggests that choices given to the patient should\n(A) avoid upsetting the patient by remaining positive.\n(B) maintain the patient’s trust by being realisable.\n(C) be limited in order to prevent confusion.", "sourcePage": 36, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 42, "prompt": "Dr Houghton recommends that when the patient is calm they should\n(A) be removed from the ED ward.\n(B) understand why their behaviour was inappropriate.\n(C) be encouraged to explain what caused their reaction.", "sourcePage": 36, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 38, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["c234c69b0e19d27814eb5cbccb44523e86cf95a5638084d7dba984e6c4c219bf"], "answerSources": [], "matchEvidence": "Exact original recording SHA-256 in the verified Jahshan collection"}]}
