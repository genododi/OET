ills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-bb43affc1e0b38d34b84", "filename": "LISTENING SAMPLE 2.pdf", "sha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper", "pages": [13, 14, 15]}], "passages": []}, {"id": "bb43affc1e0b38d3-p6", "label": "Part B · LISTENING SAMPLE 2.pdf", "part": "B", "sourceSha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "pages": [6, 7], "questions": [], "skills": ["listening"], "recordings": ["aa487ae216676409aaa8f23426a1df023d6ba8cec61b84fe3ea7ffdff28bcc2b"], "answerSources": [{"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-bb43affc1e0b38d34b84", "filename": "LISTENING SAMPLE 2.pdf", "sha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper", "pages": [13, 14, 15]}], "passages": []}, {"id": "bb43affc1e0b38d3-p8", "label": "Part C · LISTENING SAMPLE 2.pdf", "part": "C", "sourceSha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "pages": [8, 9, 10, 11, 12], "questions": [{"number": 31, "prompt": "What does Sandra Morton see as the main aim in her work?\nA to inform patients about the different treatments on offer\nB to publicise the availability of tests for the condition\nC to raise awareness of the symptoms of the illness", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 629, "answer": {"text": "B      He compared it to the experience of a relative dying.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 32, "prompt": "When Harry was offered a routine health check at his local surgery, he initially\nA resisted the idea due to his wife’s experience.\nB felt that he was too fit and well to be in need of it.\nC only agreed to attend because his doctor advised him to.", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 932, "answer": {"text": "A      Under-reporting by patients makes it hard to know how frequent it is.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 34, "prompt": "What was Harry’s response to being diagnosed with prostate cancer?\nA    He found himself reacting in a way he hadn’t anticipated.\nB    He was unconvinced by the prognosis he was given.\nC    He immediately researched treatment options online.", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "C      reported pain levels that impact on their daily lives.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 35, "prompt": "What typical patient response to the illness does Sandra mention?\nA    an unwillingness to commence appropriate medication\nB    a failure to seek advice regarding different treatment options\nC    a reluctance to talk about the embarrassing aspects of treatment", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 305, "answer": {"text": "C      made to move a simulation of the missing limb in their minds.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["listening"], "recordings": ["aa487ae216676409aaa8f23426a1df023d6ba8cec61b84fe3ea7ffdff28bcc2b"], "answerSources": [{"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-bb43affc1e0b38d34b84", "filename": "LISTENING SAMPLE 2.pdf", "sha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper", "pages": [13, 14, 15]}], "passages": []}, {"id": "f37425f1f84c94c2-p1", "label": "Listening-Sample-Test-3-Question-Paper.pdf", "part": null, "sourceSha256": "f37425f1f84c94c27320286c60488d94ab02fd31b174fd6f6826660b506c7932", "pages": [1, 2], "questions": [], "skills": ["listening"], "recordings": ["1f4bf40fdb622fc060ed6726164f9350428422edcfd16b15828a2a00af66d45a"], "answerSources": [{"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55c