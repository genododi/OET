f7c75a.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "f37425f1f84c94c2-p8", "label": "Part C · Listening-Sample-Test-3-Question-Paper.pdf", "part": "C", "sourceSha256": "f37425f1f84c94c27320286c60488d94ab02fd31b174fd6f6826660b506c7932", "pages": [8, 9, 10, 11, 12], "questions": [{"number": 31, "prompt": "How did the young patient called David react to the amputation of his leg?\nM\nA   He felt he was now excluded from normal life.\nB   He compared it to the experience of a relative dying.\nA\nC   He resented his inability to take part in physical activities.\nS", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 1162, "answer": {"text": "B      He compared it to the experience of a relative dying.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 32, "prompt": "What does Dr Sands suggest about pain in a missing or ‘phantom’ limb?\nA   Under-reporting by patients makes it hard to know how frequent it is.\nB   The discomfort can generally be traced to a physical cause.\nC   The problem affects far fewer patients than in the past.", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 1602, "answer": {"text": "A      Under-reporting by patients makes it hard to know how frequent it is.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 37, "prompt": "When describing the condition known as HS, Dr Cooper suggests that it\nA    is fairly common so should be more accurately diagnosed.\nB    would be better understood if it presented more uniformly.\nE\nC    may be incorrectly treated due to misinformation from patients.\nP                       L", "sourcePage": 10, "choices": ["A", "B", "C"], "kind": "question", "offset": 211, "answer": {"text": "A      is fairly common so should be more accurately diagnosed.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 39, "prompt": "When describing the case of a patient called Sophie, Dr Cooper suggests that\nA    HS has a tendency to get progressively worse.\nB    diagnosis of HS may require a full patient history.\nC    a multiple treatment approach is often required for HS.", "sourcePage": 10, "choices": ["A", "B", "C"], "kind": "question", "offset": 1104, "answer": {"text": "B      diagnosis of HS may require a full patient history.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 41, "prompt": "When discussing a patient called Emily, Dr Cooper suggests that her mother’s attitude\nA    reflected a lack of sympathy and understanding.\nB    led to a delay in confirming the correct diagnosis.\nC    may have contributed to the severity of the symptoms.", "sourcePage": 11, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A      reflected a lack of sympathy and understanding.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.pdf", "textPath": "imported-resources/text/77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 42, "prompt": "When discussing the treatment of HS sufferers, Dr Cooper recommends they should\nE\nA    eat healthy foods such as brown bread.\nrestrict their intake of dairy products.\nL\nB\nC    avoid all types of alcoholic drinks.\nP\nThat is the end of Part C.\nM\nYou now have two minutes to check your answers.\nA\nTHAT IS THE END OF THE LISTENING TEST\nS\nSAMPLE\n[CANDIDATE NO.] LISTENING QUESTION PAPER 11/12", "sourcePage": 11, "choices": ["A", "C"], "kind": "question", "offset": 318, "answer": {"text": "B      restrict their intake of dairy products.", "source": {"id": "offline-77288c0ac253b20d8fe8", "filename": "Listening-Sample-Test-3-Answer-Key.pdf", "sha256": "77288c0ac253b20d8fe894ba1f330aa93ce9d55ca54b5e774a344b9283f7c75a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-1