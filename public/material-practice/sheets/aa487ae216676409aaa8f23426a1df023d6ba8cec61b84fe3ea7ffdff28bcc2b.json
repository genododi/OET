aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper"}, "page": 15}}, {"number": 32, "prompt": "When Harry was offered a routine health check at his local surgery, he initially\nA resisted the idea due to his wife’s experience.\nB felt that he was too fit and well to be in need of it.\nC only agreed to attend because his doctor advised him to.", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 932, "answer": {"text": "B      felt that he was too fit and well to be in need of it.", "source": {"id": "offline-bb43affc1e0b38d34b84", "filename": "LISTENING SAMPLE 2.pdf", "sha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper"}, "page": 15}}, {"number": 34, "prompt": "What was Harry’s response to being diagnosed with prostate cancer?\nA    He found himself reacting in a way he hadn’t anticipated.\nB    He was unconvinced by the prognosis he was given.\nC    He immediately researched treatment options online.", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A      He found himself reacting in a way he hadn’t anticipated.", "source": {"id": "offline-bb43affc1e0b38d34b84", "filename": "LISTENING SAMPLE 2.pdf", "sha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper"}, "page": 15}}, {"number": 35, "prompt": "What typical patient response to the illness does Sandra mention?\nA    an unwillingness to commence appropriate medication\nB    a failure to seek advice regarding different treatment options\nC    a reluctance to talk about the embarrassing aspects of treatment", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 305, "answer": {"text": "C      a reluctance to talk about the embarrassing aspects of treatment", "source": {"id": "offline-bb43affc1e0b38d34b84", "filename": "LISTENING SAMPLE 2.pdf", "sha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper"}, "page": 15}}], "skills": ["listening"], "recordings": ["aa487ae216676409aaa8f23426a1df023d6ba8cec61b84fe3ea7ffdff28bcc2b"], "answerSources": [{"id": "offline-bb43affc1e0b38d34b84", "filename": "LISTENING SAMPLE 2.pdf", "sha256": "bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.pdf", "textPath": "imported-resources/text/bb43affc1e0b38d34b846725401656b6c96191ed4e0cf3cfeed4d0e031aca047.json", "format": "pdf", "role": "paper", "pages": [13, 14, 15]}], "passages": []}]}
