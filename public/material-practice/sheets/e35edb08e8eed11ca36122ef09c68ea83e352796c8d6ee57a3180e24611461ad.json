ary-2026-10-19-2/64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f.pdf", "textPath": "imported-resources/text/64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "What MNRI will operate with?\nAnswer _____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 152, "answer": {"text": "autonomic nervous system", "source": {"id": "offline-64c47c441fb7bc94def2", "filename": "READING ANSWERS 16.pdf", "sha256": "64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f.pdf", "textPath": "imported-resources/text/64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": "How eye movements may appear?\nAnswer ___________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 207, "answer": {"text": "freeze", "source": {"id": "offline-64c47c441fb7bc94def2", "filename": "READING ANSWERS 16.pdf", "sha256": "64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f.pdf", "textPath": "imported-resources/text/64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258faeabd366a1f.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": "What is the term which defines activation of the vestibular system which\ncauses eye movement?\nAnswer ____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 261, "answer": {"text": "Ocular-Vestibular", "source": {"id": "offline-64c47c441fb7bc94def2", "filename": "READING ANSWERS 16.pdf", "sha256": "64c47c441fb7bc94def2ff0a834db876964fb739a389b189f258