{"version": 1, "sourceSha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "documents": [{"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}], "units": [{"id": "16070af9e24056ac-p1", "label": "Part A · READING SAMPLE 2.pdf", "part": "A", "sourceSha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "pages": [1, 2, 3, 4, 5, 6, 7, 8, 9], "questions": [{"number": 1, "prompt": "the various symptoms of patients who have taken too much paracetamol?", "sourcePage": 6, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 693, "answer": {"text": "D", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 2, "prompt": "the precise levels of paracetamol in the blood which require urgent intervention?", "sourcePage": 6, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 776, "answer": {"text": "C", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 3, "prompt": "the steps to be taken when treating a paracetamol overdose patient?", "sourcePage": 6, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 871, "answer": {"text": "B", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 4, "prompt": "whether paracetamol overdose was intentional?", "sourcePage": 6, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 952, "answer": {"text": "D", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 5, "prompt": "the number of products containing paracetamol?", "sourcePage": 6, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1011, "answer": {"text": "A", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 6, "prompt": "what to do if there are no details available about the time of the overdose?", "sourcePage": 6, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1071, "answer": {"text": "B", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 7, "prompt": "dealing with paracetamol overdose patients who have not received adequate nutrition?", "sourcePage": 6, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1161, "answer": {"text": "C", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 8, "prompt": "If paracetamol is used as a long-term painkiller, what symptom may get worse?", "sourcePage": 6, "choices": [], "kind": "question", "offset": 1436, "answer": {"text": "headache(s)", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 9, "prompt": "It may be dangerous to administer paracetamol to a patient with which viral condition?", "sourcePage": 6, "choices": [], "kind": "question", "offset": 1529, "answer": {"text": "hepatitis C OR hep C", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 10, "prompt": "What condition may develop in an overdose patient who presents with jaundice?\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTA   2\n/04", "sourcePage": 6, "choices": [], "kind": "question", "offset": 1631, "answer": {"text": "ALF OR acute liver failure", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 11, "prompt": "What condition may develop on the third day after an overdose?", "sourcePage": 7, "choices": [], "kind": "question", "offset": 0, "answer": {"text": "renal failure (NOT: renal dysfunction)", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 12, "prompt": "What drug can be administered orally within 10 - 12 hours as an alternative to acetylcysteine?", "sourcePage": 7, "choices": [], "kind": "question", "offset": 70, "answer": {"text": "methionine", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 13, "prompt": "What treatment can be used if a single overdose has occurred less than an hour ago?", "sourcePage": 7, "choices": [], "kind": "question", "offset": 179, "answer": {"text": "(activated) charcoal", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 14, "prompt": "If a patient has taken metoclopramide alongside paracetamol, this may affect the\nof the paracetamol.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 456, "answer": {"text": "speed of absorption", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 15, "prompt": "After 24 hours, an overdose patient may present with pain in the                                            .", "sourcePage": 7, "choices": [], "kind": "question", "offset": 623, "answer": {"text": "right upper quadrant", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 16, "prompt": "For the first 24 hours after overdosing, patients may only have such symptoms as\n.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 745, "answer": {"text": "nausea OR vomiting OR nausea and vomiting OR vomiting and nausea", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 17, "prompt": "Acetylcysteine should be administered to patients with a paracetamol level above the high-risk treatment\nline who are taking any type of                                          medication.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 894, "answer": {"text": "enzyme-inducing", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 18, "prompt": "A non-high-risk patient should be treated for paracetamol poisoning if their paracetamol level is above\nmg/litre 8 hours after overdosing.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 1109, "answer": {"text": "100 OR a hundred OR one hundred", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 19, "prompt": "A high-risk patient who overdosed                                               hours ago should be given\nacetylcysteine if their paracetamol level is 25 mg/litre or higher.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 1314, "answer": {"text": "12 OR twelve", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}, {"number": 20, "prompt": "If a patient does not require further acetylcysteine, they should be given treatment categorised as\nonly.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 1513, "answer": {"text": "supportive (treatment)", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 26}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper", "pages": [25, 26, 27, 28]}], "passages": []}, {"id": "16070af9e24056ac-p10", "label": "Part B · READING SAMPLE 2.pdf", "part": "B", "sourceSha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "pages": [10, 11, 12, 13, 14, 15], "questions": [{"number": 2, "prompt": "When seeking consent for a post-mortem examination, it is necessary to\nA    give a valid reason for conducting it.\nB    allow all relatives the opportunity to decline it.\nC    only raise the subject after death has occurred.\nPost-Mortem Consent\nA senior member of the clinical team, preferably the Consultant in charge of the care, should raise the\npossibility of a post-mortem examination with the most appropriate person to give consent. The person\nconsenting will need an explanation of the reasons for the post-mortem examination and what it hopes\nto achieve. The first approach should be made as soon as it is apparent that a post-mortem examination\nmay be desirable, as there is no need to wait until the patient has died. Many relatives are more\nprepared for the consenting procedure if they have had time to think about it beforehand.\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTSB & C   3/16", "sourcePage": 11, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A    give a valid reason for conducting it.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 4, "prompt": "What does this manual tell us about spacer devices?\nA    Patients should try out a number of devices with their inhaler.\nB    They enable a patient to receive more of the prescribed medicine.\nC    Children should be given spacers which are smaller than those for adults.\nManual extract: Spacer devices for asthma patients\nSpacer devices remove the need for co-ordination between actuation of a pressurized metered-dose\ninhaler and inhalation. In addition, the device allows more time for evaporation of the propellant so that a\nlarger proportion of the particles can be inhaled and deposited in the lungs. Spacer devices are particularly\nuseful for patients with poor inhalation technique, for children, for patients requiring higher doses, for\nnocturnal asthma, and for patients prone to candidiasis with inhaled corticosteroids. The size of the spacer\nis important, the larger spacers with a one-way valve being most effective. It is important to prescribe a\nspacer device that is compatible with the metered-dose inhaler. Spacer devices should not be regarded as\ninterchangeable; patients should be advised not to switch between spacer devices.\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTSB & C   5/16", "sourcePage": 13, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "B    They enable a patient to receive more of the prescribed medicine.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 6, "prompt": "What does this extract from a handbook tell us about analeptic drugs?\nA    They may be useful for patients who are not fully responsive.\nB    Injections of these drugs will limit the need for physiotherapy.\nC    Care should be taken if they are used over an extended period.\nAnaleptic drugs\nRespiratory stimulants (analeptic drugs) have a limited place in the treatment of ventilatory failure in\npatients with chronic obstructive pulmonary disease. They are effective only when given by intravenous\ninjection or infusion and have a short duration of action. Their use has largely been replaced by ventilatory\nsupport. However, occasionally when ventilatory support is contra-indicated and in patients with\nhypercapnic respiratory failure who are becoming drowsy or comatose, respiratory stimulants in the short\nterm may arouse patients sufficiently to co-operate and clear their secretions.\nRespiratory stimulants can also be harmful in respiratory failure since they stimulate non-respiratory as\nwell as respiratory muscles. They should only be given under expert supervision in hospital and must be\ncombined with active physiotherapy. At present, there is no oral respiratory stimulant available for long-\nterm use in chronic respiratory failure.\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTSB & C   7/16", "sourcePage": 15, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A    They may be useful for patients who are not fully responsive.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper", "pages": [25, 26, 27, 28]}], "passages": []}, {"id": "16070af9e24056ac-p16", "label": "Part C · READING SAMPLE 2.pdf", "part": "C", "sourceSha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "pages": [16, 17, 18, 19, 20, 21, 22, 23, 24], "questions": [{"number": 7, "prompt": "What point is made about the death of a female patient called Mary?\nA    It was entirely preventable.\nB    Nobody was willing to accept the blame.\nC    Surgeons should have tried harder to save her life.\nD    It is the type of incident which is becoming increasingly common.", "sourcePage": 18, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 25, "answer": {"text": "A    It was entirely preventable.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 8, "prompt": "What is meant by the phrase ‘effort substitution’ in the second paragraph?\nA    Monetary resources are diverted unnecessarily.\nB    Time and energy is wasted on irrelevant matters.\nC    Staff focus their attention on a limited number of issues.\nD    People have to take on tasks which they are unfamiliar with.", "sourcePage": 18, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 389, "answer": {"text": "C    Staff focus their attention on a limited number of issues.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 10, "prompt": "What point is made about checklists in the third paragraph?\nA    Hospital staff sometimes forget to complete them.\nB    Nurses and surgeons are both reluctant to deal with them.\nC    They are an additional burden for over-worked nursing staff.\nD    The information recorded on them does not always reflect reality.\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTSB & C   10\n/16", "sourcePage": 18, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1227, "answer": {"text": "D    The information recorded on them does not always reflect reality.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 11, "prompt": "What problem is mentioned in the fourth paragraph?\nA    failure to act promptly\nB    outdated procedures\nC    poor communication\nD    lack of consistency", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 0, "answer": {"text": "D    lack of consistency", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 12, "prompt": "What point about patient safety is the writer making by quoting Dixon-Woods’ comparison with\nclimate change?\nA    The problem will worsen if it isn’t dealt with soon. B\nIt isn’t clear who ought to be tackling the situation. C\nIt is hard to know what the best course of action is.\nD    Many people refuse to acknowledge there is a problem.", "sourcePage": 19, "choices": ["A", "D"], "kind": "question", "offset": 235, "answer": {"text": "B    It isn’t clear who ought to be tackling the situation.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 13, "prompt": "The writer quotes Dixon-Woods’ reference to intensive care beds in order to\nA    present an alternative viewpoint.\nB    illustrate a fundamental obstacle.\nC    show the drawbacks of seemingly simple solutions.\nD    give a detailed example of how to deal with an issue.", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 678, "answer": {"text": "B    illustrate a fundamental obstacle.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 14, "prompt": "What difference between healthcare and engineering is mentioned in the final paragraph?\nA    the types of systems they use\nB    the way they exploit technology\nC    the nature of the difficulties they face\nD    the approach they take to deal with challenges\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTSB & C   11\n/16", "sourcePage": 19, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1036, "answer": {"text": "D    the approach they take to deal with challenges", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 15, "prompt": "Why does the writer tell the story of the news reporter?\nA    to explain the causes of migraine aura\nB    to address the fear surrounding migraine aura\nC    to illustrate the strange nature of migraine aura\nD    to clarify a misunderstanding about migraine aura", "sourcePage": 22, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 26, "answer": {"text": "C    to illustrate the strange nature of migraine aura", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 17, "prompt": "What does the word ‘This’ in the second paragraph refer to?\nA    the theory that connects CSD and aura\nB    the part of the brain where auras take place\nC    the simultaneous occurrence of CSD and aura\nD    the ability to predict when an aura would happen", "sourcePage": 22, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 695, "answer": {"text": "C    the simultaneous occurrence of CSD and aura", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 19, "prompt": "What does the writer find surprising about Goadsby’s research?\nA    the idea that migraine may not run in families\nB    the fact that migraine is evident in infanthood\nC    the link between childbirth and onset of migraine\nD    the suggestion that infant colic may be linked to migraine", "sourcePage": 23, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 0, "answer": {"text": "D    the suggestion that infant colic may be linked to migraine", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 20, "prompt": "According to Marla Mickleborough, what is unusual about the brain of migraine sufferers?\nA    It fails to filter out irrelevant details.\nB    It struggles to interpret visual input.\nC    It is slow to respond to sudden changes.\nD    It does not pick up on important information.", "sourcePage": 23, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 368, "answer": {"text": "A    It fails to filter out irrelevant details.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 21, "prompt": "The writer uses the phrase ‘a silver lining’ in the final paragraph to emphasise\nA    the privileged position of some sufferers.\nB    a more positive aspect of the research.\nC    the way migraine affects older people.\nD    the value of publicising the research.", "sourcePage": 23, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 736, "answer": {"text": "B    a more positive aspect of the research.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}, {"number": 22, "prompt": "What does the writer suggest about the brain changes seen in migraine sufferers?\nA    Some of them may be beneficial.\nB    They are unlikely to be permanent.\nC    Some of them make treatment unnecessary.\nD    They should still be seen as a cause for concern.", "sourcePage": 23, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1087, "answer": {"text": "B    They are unlikely to be permanent.", "source": {"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper"}, "page": 28}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-16070af9e24056ac4fea", "filename": "READING SAMPLE 2.pdf", "sha256": "16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.pdf", "textPath": "imported-resources/text/16070af9e24056ac4feaf34f8970ce5043e7ca4aa5250e2e58759bb304b40d65.json", "format": "pdf", "role": "paper", "pages": [25, 26, 27, 28]}], "passages": []}]}
