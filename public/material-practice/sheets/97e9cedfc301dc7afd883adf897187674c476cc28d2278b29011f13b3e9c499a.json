{"version": 1, "sourceSha256": "97e9cedfc301dc7afd883adf897187674c476cc28d2278b29011f13b3e9c499a", "documents": [{"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-97e9cedfc301dc7afd88", "filename": "READING 25.pdf", "sha256": "97e9cedfc301dc7afd883adf897187674c476cc28d2278b29011f13b3e9c499a", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/97e9cedfc301dc7afd883adf897187674c476cc28d2278b29011f13b3e9c499a.pdf", "textPath": "imported-resources/text/97e9cedfc301dc7afd883adf897187674c476cc28d2278b29011f13b3e9c499a.json", "format": "pdf", "role": "paper"}], "units": [{"id": "97e9cedfc301dc7a-p1", "label": "Part A · READING 25.pdf", "part": "A", "sourceSha256": "97e9cedfc301dc7afd883adf897187674c476cc28d2278b29011f13b3e9c499a", "pages": [1, 2, 3, 4, 5], "questions": [{"number": 1, "prompt": ".Occurs in two different phases.\nAnswer ________", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1039, "answer": {"text": "C", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "All patterns are gradual.\nAnswer_________", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1092, "answer": {"text": "D", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "He believed that ME is more complicated.\nAnswer___________", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1139, "answer": {"text": "C", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": "Controversy over the disease conditions.\nAnswer__________", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1203, "answer": {"text": "A", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": ".No clear definition.\nAnswer__________", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1266, "answer": {"text": "D", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "Who thinks that ME is long lasting and ant it can be acquired extreme onset?\nAnswer___________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 304, "answer": {"text": "Hyde", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": ".Who defined onset as incurable?\nAnswer____________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 404, "answer": {"text": "DeLuca", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": "According to which principle, CFS involves a definite onset & clear evidence\nof infection?\nAnswer_____________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 460, "answer": {"text": "Oxford Criteria", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "Who specified that the CFS symptoms must occur over a few hours or days,\nindicating an acute onset?\nAnswer ____________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 577, "answer": {"text": "Holmes", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": ".Who described that sudden onset for CFS as an unrecoverable viral-like\nillness?\nAnswer___________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 703, "answer": {"text": "DeLuca et al.", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 13, "prompt": ".Whose statement signifies that the affected patient may go through a highly\nsecretive and detrimental beginning?\nAnswer ___________", "sourcePage": 4, "choices": [], "kind": "question", "offset": 807, "answer": {"text": "Carruthers", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": ".Who described onset as more debilitating fatigue?\nAnswer___________\nSimilar to the Oxford Criteria", "sourcePage": 5, "choices": [], "kind": "question", "offset": 0, "answer": {"text": "Bell", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": ".____________ described the onset phase of ME as the Primary Infection", "sourcePage": 5, "choices": [], "kind": "question", "offset": 261, "answer": {"text": "Hyde", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "ME may follow ___________ infections in patients with not-so-strong\nimmune system", "sourcePage": 5, "choices": [], "kind": "question", "offset": 336, "answer": {"text": "Multiple Minor", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 17, "prompt": ".CFS criteria are said to have much more similarity with respect\nto____________", "sourcePage": 5, "choices": [], "kind": "question", "offset": 423, "answer": {"text": "Fukuda Criteria", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "CFS may comprise a___________ onset and strong evidence of infection when\nthere are first signs of symptoms.", "sourcePage": 5, "choices": [], "kind": "question", "offset": 507, "answer": {"text": "Sudden", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "The distinction is made between _____________ and insidious/gradual onset,\nbut the duration length prescribed to each category differs.\n20.____________ may occur due to an infectious or autoimmune agent.", "sourcePage": 5, "choices": [], "kind": "question", "offset": 621, "answer": {"text": "Hydes", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "97e9cedfc301dc7a-p6", "label": "Part B · PART B", "part": "B", "sourceSha256": "97e9cedfc301dc7afd883adf897187674c476cc28d2278b29011f13b3e9c499a", "pages": [6, 7, 8, 9, 10, 11], "questions": [{"number": 1, "prompt": "What is correct about gait disturbance?\nPelvic tilt is common\nFast gait speed and improved gait pattern is the most important goal of stroke\nrehabilitation\nA hemiplegic gait may include body asymmetry, decreased weight bearing on\nthe affected side.\nGait disturbance\nGait disturbance is the most common problem after stroke. This problem is related\nto poor ADL and mobility, and increases the risk of fall in severe cases. The body\nalignment of stroke patients becomes asymmetric if they have a hemi-paralysis,\nmuscle weakness, motor and sensory function decrease. These problems produce a\nhemiplegic gait in stroke patients. It may include poor equilibrium reaction, and\nimpaired selective motor control. Good body alignment is very important clinically\nbecause asymmetry leads to inefficient energy during walking, the risk of\nmusculoskeletal injury in the unaffected side, and loss of bone density. Excessive\npelvic elevation and the pelvic tilt angle is directly connected to hemiplegic gait\nand poor motor function in stroke patient causes an excessive pelvic tilt during gait", "sourcePage": 6, "choices": ["A"], "kind": "question", "offset": 208, "answer": {"text": "A hemiplegic gait may include body asymmetry, decreased weight bearing on", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "97e9cedfc301dc7a-p12", "label": "Part C · PART C", "part": "C", "sourceSha256": "97e9cedfc301dc7afd883adf897187674c476cc28d2278b29011f13b3e9c499a", "pages": [12, 13, 14, 15, 16, 17, 18, 19, 20], "questions": [{"number": 1, "prompt": "to 3 weeks or longer. In older children and adults, right-sided abdominal pain and\nfever may be the predominant symptoms, and may be confused with appendicitis.\nIn a small proportion of cases, complications such as skin rashes, joint pains, or\nthe spread of bacteria to the bloodstream can occur.\nY. enterocolitica belongs to a family of rod-shaped bacteria. Other species of\nbacteria in this family include Y. pseudotuberculosis, which causes an illness\nsimilar to Y. enterocolitica, and Y. pestis, which cause plague. Only a few strains\nof Y. enterocolitica cause illness in humans. The major animal reservoir for Y.\nenterocolitica strains that causes human illness is pigs, but other strains are also\nfound in many other animals including rodents, rabbits, sheep, cattle, horses, dogs,\nand cats. In pigs, the bacteria are most likely to be found on the tonsils.\nInfection is most often acquired by eating contaminated food, especially raw or\nundercooked pork products. The preparation of raw pork intestines (chitterlings)\nmay be particularly risky. Infants can be infected if their caretakers handle raw\nchitterlings and then do not adequately clean their hands before handling the infant\nor the infant’s toys, bottles, or pacifiers. Drinking contaminated unpasteurized milk\nor untreated water can also transmit the infection. Occasionally Y. enterocolitica\ninfection occurs after contact with infected animals. On rare occasions, it can be", "sourcePage": 12, "choices": [], "kind": "question", "offset": 797, "answer": {"text": "C", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 13, "prompt": "Which of these can be derived from Paragraph 5?\nTreatment is not required for the infection caused by Y. enterocolitica.\nDiarrhea requires no treatment\nComplications which are mild can be resolved easily.\nNone", "sourcePage": 15, "choices": [], "kind": "question", "offset": 377, "answer": {"text": "None", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": "What is said about chitterlings?", "sourcePage": 15, "choices": [], "kind": "question", "offset": 613, "answer": {"text": "Washing hands with soap before touching infants or their toys is vital", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "According to paragraph 1, an image is produced;\nWhen a signal is detected by the receiver portion of the scanner.\nWhen the signal passes through the receiver, after coupling of the protons of\nthe body.\nWhen the signal is identified by the receiver which is accurately processed by\na computer.\nOnly when the information, detected by the receiver is processed by a\ncomputer.", "sourcePage": 18, "choices": ["A"], "kind": "question", "offset": 132, "answer": {"text": "Only when the information, detected by the receiver is processed by a", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "According to paragraph 1, what is the image like?\nCrystal clear with no patches.\nSelf explanatory\nDense\nWell enough to give a clear idea of the structures within the body.", "sourcePage": 18, "choices": [], "kind": "question", "offset": 530, "answer": {"text": ": Dense", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 17, "prompt": "According to paragraph 2, an MRI gives a clear idea about;\nBrain aneurysms.\nStrokes of the brain.\nBrain tumours and spinal cord injury.\nAll", "sourcePage": 18, "choices": [], "kind": "question", "offset": 727, "answer": {"text": "All", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 22, "prompt": "According to paragraph 5, interpreting the images implies;\nIdentifying the disease through scanning.\nAnalysis of the disease.\nDecoding the report.\nAll of the above.", "sourcePage": 20, "choices": [], "kind": "question", "offset": 43, "answer": {"text": "All of the above.", "source": {"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.pdf", "textPath": "imported-resources/text/86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-86cfc775bc6aa85d657e", "filename": "READING ANSWERS 25.pdf", "sha256": "86cfc775bc6aa85d657e1f9a9e25a1e4c7261d85c169ad025ad269cd8846f72e", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/86cfc775bc6aa85d657e1f9a9e25a1e