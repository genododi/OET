-f5cd8d7b62432570992b", "filename": "Reading-Sample-Test-1-Answer-Key-Part-A.pdf", "sha256": "f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd.pdf", "textPath": "imported-resources/text/f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd.json", "format": "pdf", "role": "answer-key"}], "passages": [{"sourceSha256": "a353ebfe690e4fe86b7c1eb987fb3979c1b91627821c3b5bba90562a11506a9d", "pages": [1, 2, 3, 4]}]}, {"id": "86e3edf245bb345e-p6", "label": "Part B · Listening-Sample-Test-1-Question-Paper.pdf", "part": "B", "sourceSha256": "86e3edf245bb345e110a79032cf57f14110ba449494f7495e8dd18ba9daaf7dc", "pages": [6, 7], "questions": [], "skills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-34c7d05b28deb4608782", "filename": "Listening-Sample-Test-1-Answer-Key.pdf", "sha256": "34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.pdf", "textPath": "imported-resources/text/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "86e3edf245bb345e-p8", "label": "Part C · Listening-Sample-Test-1-Question-Paper.pdf", "part": "C", "sourceSha256": "86e3edf245bb345e110a79032cf57f14110ba449494f7495e8dd18ba9daaf7dc", "pages": [8, 9, 10, 11, 12], "questions": [{"number": 31, "prompt": "Why does Dr Robson regard Chagas as a neglected disease?\nM\nA   because of the social groups it mainly affects\nB   because patients often don’t realise they’re infected\nA\nC   because its impact is severe in a relatively small number of cases\nS", "sourcePage": 8, "choices": ["A", "B", "C"], "kind": "question", "offset": 1144}, {"number": 34, "prompt": "What problem does Dr Robson identify in the case of a patient called Jennifer?\nA    an unwillingness to accept that she was ill\nB    an inability to tolerate the prescribed medicine\nC    a delay between the initial infection and treatment", "sourcePage": 9, "choices": ["A", "B", "C"], "kind": "question", "offset": 0}, {"number": 35, "prompt": "What does Dr Robson say about his patient called Juan?\nE\nA    The development of his illness was typical of people with Chagas.\nAn incorrect initial diagnosis resulted in his condition worsening.\nL\nB\nC    The medication he took was largely ineffective.\n36.\nP\nDr Robson thinks the short-term priority in the ﬁght against Chagas is to\nA\nM\nincrease efforts to eliminate the insects which carry the parasite.\nA\nB    produce medication in a form that is suitable for children.\nS\nC    design and manufacture a viable vaccine.\nNow look at extract two.\nSAMPLE\n[CANDIDATE NO.] LISTENING QUESTION PAPER 09/12", "sourcePage": 9, "choices": ["A", "C", "B"], "kind": "question", "offset": 302}, {"number": 38, "prompt": "When Anna ﬁrst met the patient called Ted, she was\nA    unable to identify completely with his attitude.\nM\nB    optimistic that he would regain full mobility.\nmainly concerned about his state of mind.\nA\nC\nS", "sourcePage": 10, "choices": ["A", "B"], "kind": "question", "offset": 712}], "skills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-34c7d05b28deb4608782", "filename": "Listening-Sample-Test-1-Answer-Key.pdf", "sha256": "34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.pdf", "textPath": "imported-resources/text/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "7779f0d1321e9200-p1", "label": "Part A · Reading-Sample-Test-1-Question-Paper-Part-A.pdf", "part": "A", "sourceSha256": "7779f0d1321e92004f7ee11c3552c68976ddf899a40203f90d19713037a4614c", "pages": [1, 2, 3, 4], "questions": [{"number": 1, "prompt": "procedures for delivering pain relief?", "sourcePage": 2, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 955}, {"number": 2, "prompt": "the procedure to follow when splinting a fractured limb?\nS", "sourcePage": 2, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1043}, {"number": 3, "prompt": "what to record when assessing a patient?", "sourcePage": 2, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1163}, {"number": 4, "prompt": "the terms used to describe different types of fractures?", "sourcePage": 2, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1251}, {"number": 5, "prompt": "the practitioners who administer analgesia?", "sourcePage": 2, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1339}, {"number": 6, "prompt": "what to look for when checking an injury?", "sourcePage": 2, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1427}, {"number": 7, "prompt": "how fractures can be caused?", "sourcePage": 2, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1515}, {"number": 8, "prompt": "What should be used to elevate a patient’s fractured leg?", "sourcePage": 2, "choices": [], "kind": "question", "offset": 1788}, {"number": 9, "prompt": "What is the maximum dose of morphine per kilo of a patient’s weight that can be given using\nthe intra-muscular (IM) route?", "sourcePage": 2, "choices": [], "kind": "question", "offset": 1901}, {"number": 10, "prompt": "Which parts of a limb may need extra padding?\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PART A 02/04", "sourcePage": 2, "choices": [], "kind": "question", "offset": 2106}, {"number": 11, "prompt": "What should be used to treat a patient who suffers respiratory depression?", "sourcePage": 3, "choices": [], "kind": "question", "offset": 0}, {"number": 12, "prompt": "What should be used to cover a freshly applied plaster backslab?", "sourcePage": 3, "choices": [], "kind": "question", "offset": 117}, {"number": 13, "prompt": "What analgesic should be given to a patient who is allergic to morphine?\nE", "sourcePage": 3, "choices": [], "kind": "question", "offset": 237}, {"number": 14, "prompt": "What condition might a patient have if severe pain persists after splinting, elevation and\nL\nrepeated analgesia?\nP", "sourcePage": 3, "choices": [], "kind": "question", "offset": 452}, {"number": 15, "prompt": "Falling on an outstretched hand is a typical cause of a                                        of\nthe elbow.\nS", "sourcePage": 3, "choices": [], "kind": "question", "offset": 1065}, {"number": 16, "prompt": "Upper limb fractures should be elevated by means of a                                              .", "sourcePage": 3, "choices": [], "kind": "question", "offset": 1257}, {"number": 17, "prompt": "Make sure the patient isn’t wearing any                                        on the part of the\nbody where the plaster backslab is going to be placed.", "sourcePage": 3, "choices": [], "kind": "question", "offset": 1382}, {"number": 18, "prompt": "Check to see whether swollen limbs are                                          or increasing\nin size.", "sourcePage": 3, "choices": [], "kind": "question", "offset": 1585}, {"number": 19, "prompt": "In a plaster backslab, there is a layer of                                     closest to the skin.", "sourcePage": 3, "choices": [], "kind": "question", "offset": 1737}, {"number": 20, "prompt": "Patients aged                                         and over shouldn’t be given the higher\ndosages of pain relief.", "sourcePage": 3, "choices": [], "kind": "question", "offset": 1861}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-34c7d05b28deb4608782", "filename": "Listening-Sample-Test-1-Answer-Key.pdf", "sha256": "34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.pdf", "textPath": "imported-resources/text/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-f5cd8d7b62432570992b", "filename": "Reading-Sample-Test-1-Answer-Key-Part-A.pdf", "sha256": "f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd.pdf", "textPath": "imported-resources/text/f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd.json", "format": "pdf", "role": "answer-key"}], "passages": [{"sourceSha256": "a353ebfe690e4fe86b7c1eb987fb3979c1b91627821c3b5bba90562a11506a9d", "pages": [1, 2, 3, 4]}]}, {"id": "f20de8bd3c7c3ea5-p1", "label": "Reading-Sample-Test-1-Question-Paper-Part-BC.pdf", "part": null, "sourceSha256": "f20de8bd3c7c3ea56e8a2182e316b8e018802ffafe3a477ae50244117873075f", "pages": [1], "questions": [], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-34c7d05b28deb4608782", "filename": "Listening-Sample-Test-1-Answer-Key.pdf", "sha256": "34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.pdf", "textPath": "imported-resources/text/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-f5cd8d7b62432570992b", "filename": "Reading-Sample-Test-1-Answer-Key-Part-A.pdf", "sha256": "f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd.pdf", "textPath": "imported-resources/text/f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "f20de8bd3c7c3ea5-p2", "label": "Part B · Reading-Sample-Test-1-Question-Paper-Part-BC.pdf", "part": "B", "sourceSha256": "f20de8bd3c7c3ea56e8a2182e316b8e018802ffafe3a477ae50244117873075f", "pages": [2, 3, 4, 5, 6, 7], "questions": [{"number": 3, "prompt": "What must all staff involved in the transfusion process do?\nA    check that their existing training is still valid\nB    attend a course to learn about new procedures\nC    read a document that explains changes in policy\nE\n'Right Patient, Right Blood' Assessments\nThe administration of blood can have significant morbidity and mortality. Following the introduction of the\nL\n'Right Patient, Right Blood' safety policy, all staff involved in the transfusion process must be competency\nassessed. To ensure the safe administration of blood components to the intended patient, all staff must be\nP\naware of their responsibilities in line with professional standards.\nStaff must ensure that if they take any part in the transfusion process, their competency assessment is\nM\nupdated every three years. All staff are responsible for ensuring that they attend the mandatory training\nidentified for their roles. Relevant training courses are clearly identified in Appendix 1 of the Mandatory\nA\nTraining Matrix.\nS\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTS B & C 04/16", "sourcePage": 4, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A       check that their existing training is still valid", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-34c7d05b28deb4608782", "filename": "Listening-Sample-Test-1-Answer-Key.pdf", "sha256": "34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.pdf", "textPath": "imported-resources/text/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "f20de8bd3c7c3ea5-p8", "label": "Part C · Reading-Sample-Test-1-Question-Paper-Part-BC.pdf", "part": "C", "sourceSha256": "f20de8bd3c7c3ea56e8a2182e316b8e018802ffafe3a477ae50244117873075f", "pages": [8, 9, 10, 11, 12, 13, 14, 15, 16], "questions": [{"number": 7, "prompt": "In the first paragraph, the writer uses Eve Van Cauter’s words to\nA    explain the main causes of sleep deprivation.\nB    reinforce a view about the impact of sleep deprivation.\nC    question some research findings about sleep deprivation.\nD    describe the challenges involved in sleep deprivation research.\nE", "sourcePage": 10, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 25, "answer": {"text": "B       reinforce a view about the impact of sleep deprivation.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "What do we learn about sleep in the second paragraph?\nL\nA    Scientific opinion about its function has changed in recent years.\nP\nB    There is now more controversy about it than there was in the past.\nC    Researchers have tended to confirm earlier ideas about its purpose.\nM\nD    Studies undertaken in the past have formed the basis of current research.\nA", "sourcePage": 10, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 508, "answer": {"text": "C       Researchers have tended to confirm earlier ideas about its purpose.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": "What particularly impressed Bob McCarley of Harvard Medical School?\nS\nA    the effectiveness of adenosine as a sedative\nB    the influence of caffeine on adenosine receptors\nC    the simultaneous production of adenosine and adenosine receptors\nD    the extent to which adenosine levels fall when subjects are allowed to sleep", "sourcePage": 10, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1178, "answer": {"text": "C       the simultaneous production of adenosine and adenosine receptors", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": "In the third paragraph, what idea is emphasised by the phrase ‘by no means the be-all and end-all’?\nA    Sleep deprivation has consequences beyond its impact on adenosine levels.\nB    Adenosine levels are a significant factor in situations other than sleep deprivation.\nC    The role of adenosine as a response to sleep deprivation is not yet fully understood.\nD    The importance of the link between sleep deprivation and adenosine should not be underestimated.\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTS B & C 10/16", "sourcePage": 10, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1623, "answer": {"text": "A       Sleep deprivation has consequences beyond its impact on adenosine levels.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "What was significant about the findings in Van Cauter’s experiment?\nA    the rate at which the sleep-deprived men entered a pre-diabetic state\nB    the fact that sleep deprivation had an influence on the men’s glucose levels\nC    the differences between individual men with regard to their glucose tolerance\nD    the extent of the contrast in the men’s metabolic states between sleep debt and recovery\nE", "sourcePage": 11, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 0, "answer": {"text": "D          the extent of the contrast in the men’s metabolic states between sleep debt and recovery", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": "In the fifth paragraph, what does the word ‘it’ refer to?\nL\nA    an enzyme\nP\nB    new evidence\nC    a catabolic state\nM\nD    enforced lack of sleep\nA", "sourcePage": 11, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 570, "answer": {"text": "D       enforced lack of sleep", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 13, "prompt": "What aspect of her findings surprised Chiara Cirelli?\nS\nA    There was no reversal of a certain effect of sleep deprivation.\nB    The cortical neurons of the mice underwent structural changes.\nC    There was evidence of an increased need for energy in the brains of the mice.\nD    The neurological response to sleep deprivation only took a few hours to become apparent.", "sourcePage": 11, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1034, "answer": {"text": "A       There was no reversal of a certain effect of sleep deprivation.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": "In the final paragraph, the quote from Van Cauter is used to suggest that\nA    the goals of sleep deprivation research are sometimes unclear.\nB    it could be difficult to develop any treatment for sleep deprivation.\nC    opinions about the best way to deal with sleep deprivation are divided.\nD    there is still a great deal to be learnt about the effects of sleep deprivation.\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTS B & C 11/16", "sourcePage": 11, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1523, "answer": {"text": "B       it could be difficult to develop any treatment for sleep deprivation.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "In the first paragraph, the writer questions whether\nA    adult ADHD should have been recognised as a disorder at an earlier date.\nB    ADHD should be diagnosed in the same way for children and adults.\nC    ADHD can actually be indicated by neurological markers.\nD    cases of ADHD have genuinely increased in the USA.\nE", "sourcePage": 14, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 26, "answer": {"text": "D       cases of ADHD have genuinely increased in the USA.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "What does Dr Saul object to?\nL\nA    the suggestion that people need stimulants to cope with everyday life\nP\nB    the implication that everyone has some symptoms of ADHD\nC    the grouping of imprecise symptoms into a mental disorder\nM\nD    the treatment for ADHD suggested by Dr Barkley\nA", "sourcePage": 14, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 519, "answer": {"text": "C       the grouping of imprecise symptoms into a mental disorder", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 17, "prompt": "The writer regards the study of children in foster care as significant because it\nS\nA    highlights the difficulty of distinguishing ADHD from other conditions.\nB    focuses on children known to have complex mental disorders.\nC    suggests a link between ADHD and a child’s upbringing.\nD    draws attention to the poor care given to such children.", "sourcePage": 14, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1119, "answer": {"text": "A       highlights the difficulty of distinguishing ADHD from other conditions.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "In the fourth paragraph, the word ‘They’ refers to\nA    syndromes.\nB    questions.\nC    studies.\nD    origins.\nSAMPLE\n[CANDIDATE NO.] READING QUESTION PAPER PARTS B & C 14/16", "sourcePage": 14, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1586, "answer": {"text": "C       studies.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 20, "prompt": "In the fifth paragraph, it is suggested that drug companies have\nL\nA    been overly aggressive in their marketing of ADHD medication.\nP\nB    influenced research that led to the reworking of ADHD diagnostic criteria.\nC    attempted to change the rules about incentives for doctors who diagnose ADHD.\nM\nD    encouraged the APA to rush through changes to the criteria for diagnosing ADHD.\nA", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 458, "answer": {"text": "B       influenced research that led to the reworking of ADHD diagnostic criteria.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 21, "prompt": "In the final paragraph, the word ‘trademark’ refers to\nS\nA    a physiological reaction.\nB    a substitute medication.\nC    a need for research.\nD    a common request.", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1159, "answer": {"text": "A       a physiological reaction.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 22, "prompt": "In the final paragraph, what does the writer imply about addiction to ADHD medication?\nA    It is unlikely to turn into a problem on the scale of that caused by opioid abuse.\nB    The effects are more marked in certain sectors of the population.\nC    Insufficient attention seems to have been paid to it.\nD    The reasons for it are not yet fully understood.", "sourcePage": 15, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 1445, "answer": {"text": "C       Insufficient attention seems to have been paid to it.", "source": {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-34c7d05b28deb4608782", "filename": "Listening-Sample-Test-1-Answer-Key.pdf", "sha256": "34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.pdf", "textPath": "imported-resources/text/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "a353ebfe690e4fe8-p1", "label": "Part A · Reading-Sample-Test-1-Text-Booklet-Part-A.pdf", "part": "A", "sourceSha256": "a353ebfe690e4fe86b7c1eb987fb3979c1b91627821c3b5bba90562a11506a9d", "pages": [1, 2, 3, 4], "questions": [], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-34c7d05b28deb4608782", "filename": "Listening-Sample-Test-1-Answer-Key.pdf", "sha256": "34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.pdf", "textPath": "imported-resources/text/34c7d05b28deb4608782af7f6cbca6faa5f99bb4350f6b26853940e4c622c950.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-d929a52a36caac8fe4a5", "filename": "Reading-Sample-Test-1-Answer-Key-Part-BC.pdf", "sha256": "d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.pdf", "textPath": "imported-resources/text/d929a52a36caac8fe4a5c53a75ee443146e92f63973c2541242e1e90943552ec.json", "format": "pdf", "role": "answer-key"}, {"id": "offline-f5cd8d7b62432570992b", "filename": "Reading-Sample-Test-1-Answer-Key-Part-A.pdf", "sha256": "f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/f5cd8d7b62432570992b875f8502e13f86843ad5d5907f4a4667eab21662c0cd.pdf", "textPath": "imported-resources/text/f5cd8d7b62432570992b875f8502e13f868