{"version": 1, "sourceSha256": "5276df4d58ba55a81ab557db933fe0b8b752c958e878c017d4e96b6889ef42c0", "documents": [{"id": "offline-5276df4d58ba55a81ab5", "filename": "Listening B.mp3", "sha256": "5276df4d58ba55a81ab557db933fe0b8b752c958e878c017d4e96b6889ef42c0", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-5/5276df4d58ba55a81ab557db933fe0b8b752c958e878c017d4e96b6889ef42c0.mp3", "textPath": "imported-resources/text/5276df4d58ba55a81ab557db933fe0b8b752c958e878c017d4e96b6889ef42c0.json", "format": "mp3", "role": "recording"}, {"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}, {"id": "offline-f25b67a03fabda54b684", "filename": "Part B.pdf", "sha256": "f25b67a03fabda54b684aacf9e322b1dfaa21ac1be5f073066eb8d28d425275d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/f25b67a03fabda54b684aacf9e322b1dfaa21ac1be5f073066eb8d28d425275d.pdf", "textPath": "imported-resources/text/f25b67a03fabda54b684aacf9e322b1dfaa21ac1be5f073066eb8d28d425275d.json", "format": "pdf", "role": "paper"}], "units": [{"id": "f25b67a03fabda54-p1", "label": "Part B · Part B.pdf", "part": "B", "sourceSha256": "f25b67a03fabda54b684aacf9e322b1dfaa21ac1be5f073066eb8d28d425275d", "pages": [1, 2, 3], "questions": [{"number": 1, "prompt": "\nYou hear two doctors discussing a patient.\nDr Jones speaks to Dr Khan because he wants to\nA. confirm his own diagnosis.\nB. hear Dr Khan’s diagnosis.\nC. send the patient for tests.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 358, "answer": {"text": "A", "source": {"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "\nYou hear a dietician talking to a patient.\nWhat is she doing?\nA. Showing the patient alternative diet plans that eliminate fat.\nB. Explaining why the doctor wants the patient to eat a low-fat diet.\nC. Empathising with the patient about the challenges of reducing fat.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 637, "answer": {"text": "C", "source": {"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "\nYou hear a professor of emergency medicine giving a presentation to a group of trainee\ndoctors.\nThe presentation is about\nA. why European wasps are a problem.\nB. what European wasps like to eat.\nC. how European wasps sting.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A", "source": {"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": "\nYou hear a GP talking to a regular patient who has been having kidney problems.\nWhat does the GP suggest?\nA. That the patient’s lifestyle will change forever.\nB. That there is more than one way to treat the patient.\nC. That the patient needs dialysis for the rest of their life.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 323, "answer": {"text": "B", "source": {"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "\nYou hear a physiotherapist in a hospital talking with John, a new patient.\nThe physiotherapist is\nA. providing sports recovery options.\nB. explaining why warm showers are beneficial.\nC. giving instructions to assist with recovery from an injury.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 701, "answer": {"text": "C", "source": {"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": "\nYou hear a specialist physician and a nurse discussing a patient’s treatment.\nThe nurse is unable to help the physician because\nA. she isn't senior enough\nB. she isn't familiar with the patient.\nC. she doesn't understand the treatment options.", "sourcePage": 3, "choices": ["A", "B", "C"], "kind": "question", "offset": 19, "answer": {"text": "B", "source": {"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}, "page": 1}}], "skills": ["listening"], "recordings": ["5276df4d58ba55a81ab557db933fe0b8b752c958e878c017d4e96b6889ef42c0"], "answerSources": [{"id": "offline-67dc229f3dc92bc8cc92", "filename": "Listening Part B-answers.docx", "sha256": "67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.docx", "textPath": "imported-resources/text/67dc229f3dc92bc8cc92356e53881fa44dc3adb62e1e6f84d65c4c1cb8cf5b7f.json", "format": "docx", "role": "answer-key"}], "passages": []}]}
