ssetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/6f60f8c9e0dcee8b669df18784a576ab6f8c10d2576b3deffe8915b2b4ab15fb.docx", "textPath": "imported-resources/text/6f60f8c9e0dcee8b669df18784a576ab6f8c10d2576b3deffe8915b2b4ab15fb.json", "format": "docx", "role": "answer-key"}, {"id": "offline-e32a65896f18aa6b408d", "filename": "Listening Part A- Ryan Henderson answers.docx", "sha256": "e32a65896f18aa6b408d575786d4668e7a3175050335528d7a72ea7286b8df59", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/e32a65896f18aa6b408d575786d4668e7a3175050335528d7a72ea7286b8df59.docx", "textPath": "imported-resources/text/e32a65896f18aa6b408d575786d4668e7a3175050335528d7a72ea7286b8df59.json", "format": "docx", "role": "answer-key"}], "passages": []}, {"id": "87887b5c4365cc9b-p1", "label": "Part B · Part B.pdf", "part": "B", "sourceSha256": "87887b5c4365cc9b89906090bad3c197d21102e84fa78a28010ab8961782a634", "pages": [1, 2, 3], "questions": [{"number": 1, "prompt": "\nYou hear a doctor talking to a patient who has been having trouble with his water.\nThe doctor wants to confirm if the patient\nA. has had burning when passing water.\nB. has a blockage in their kidneys.\nC. has high blood pressure.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 397, "answer": {"text": "B", "source": {"id": "offline-53002d2b0e211ea123b9", "filename": "Listening Part B-answers.docx", "sha256": "53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.docx", "textPath": "imported-resources/text/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "\nYou hear a nurse briefing her colleague about a patient.\nWhat does she want her colleague to do?\nA. Check the patient is receiving the correct amount of fluids.\nB. Order another chest radiograph to check for an effusion.\nC. Confirm the patient is stable and check his blood culture.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 723, "answer": {"text": "C", "source": {"id": "offline-53002d2b0e211ea123b9", "filename": "Listening Part B-answers.docx", "sha256": "53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.docx", "textPath": "imported-resources/text/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "\nYou hear part of a consultation at a GP practice with a patient suffering from depression\nand sleep disturbances.\nThe GP recommends cognitive behavioural therapy because\nA. there are better ways for the patient to respond to life's challenges.\nB. it will help the patient better manage the way he feels when stressed.\nC. the patient needs to control his anger and medication isn't working.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "B", "source": {"id": "offline-53002d2b0e211ea123b9", "filename": "Listening Part B-answers.docx", "sha256": "53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.docx", "textPath": "imported-resources/text/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": "\nYou hear a nurse seeking advice from a doctor.\nWhy does the nurse telephone the doctor?\nA. She would like to know how to proceed with the patient.\nB. The patient is in intense pain and has a fever.\nC. She suspects that the patient has an infection.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 483, "answer": {"text": "A", "source": {"id": "offline-53002d2b0e211ea123b9", "filename": "Listening Part B-answers.docx", "sha256": "53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.docx", "textPath": "imported-resources/text/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "\nYou hear the principal of an aged care home talking to staff about osteoporosis.\nShe wants to highlight that\nA. there are now treatments available for men.\nB. residents are not getting enough calcium and vitamin D.\nC. a lot of the residents may already have osteoporosis.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 831, "answer": {"text": "A", "source": {"id": "offline-53002d2b0e211ea123b9", "filename": "Listening Part B-answers.docx", "sha256": "53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.docx", "textPath": "imported-resources/text/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": "\nYou hear two nurses discussing a patient, Mrs Robbins.\nJulie says Mrs Robbins refused to mobilise because\nA. she was happy having a sponge bath.\nB. she wanted to hear directly from the doctor.\nC. she was upset and wanted to be left alone.\nOur Brochures\nVirtual Class Brochure\nGroup Classes Brochure\nHome\n Privacy Policy\n Terms of Use\n   Technology Requirements\n Articles\nSocial networks", "sourcePage": 3, "choices": ["A", "B", "C"], "kind": "question", "offset": 19, "answer": {"text": "B", "source": {"id": "offline-53002d2b0e211ea123b9", "filename": "Listening Part B-answers.docx", "sha256": "53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.docx", "textPath": "imported-resources/text/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.json", "format": "docx", "role": "answer-key"}, "page": 1}}], "skills": ["listening"], "recordings": ["abcb1720f89b4f0bdfd9cce5dea4a744e5c17e96079c55b6c167420659845abc"], "answerSources": [{"id": "offline-53002d2b0e211ea123b9", "filename": "Listening Part B-answers.docx", "sha256": "53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.docx", "textPath": "imported-resources/text/53002d2b0e211ea123b91537c38f560493149ae05c9f519112fdd0f45941c155.json", "format": "docx", "role": "answer-key"}], "passages": []}, {"id": "d2a1a5cedb8db432-p1", "label": "Part C · Part C.pdf", "part": "C", "sourceSha256": "d2a1a5cedb8db4327791ac26b343788cf901e8bb423db5b4c3c0320c38614229", "pages": [1, 2], "questions": [{"number": 1, "prompt": "\nDr Tredellow believes snoring poses concerns because\nA. it is possible for anyone to become a snorer.\nB. it contributes to several other health issues.\nC. everyone has an upper airway that collapses.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 420, "answer": {"text": "B", "source": {"id": "offline-9128392344abd0934268", "filename": "Listening Part C- Snoring answers.docx", "sha256": "9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.docx", "textPath": "imported-resources/text/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "\nDr Tredellow says the main cause of snoring is\nA. drinking too much.\nB. being overweight.\nC. a narrow airway.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 659, "answer": {"text": "C", "source": {"id": "offline-9128392344abd0934268", "filename": "Listening Part C- Snoring answers.docx", "sha256": "9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.docx", "textPath": "imported-resources/text/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": "\nWhat point does Dr Tredellow make about obstructive sleep apnoea?\nA. snoring sometimes causes people to stop breathing.\nB. snoring can be linked to obstructive sleep apnoea.\nC. obstructive sleep apnoea and snoring are similar.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 194, "answer": {"text": "B", "source": {"id": "offline-9128392344abd0934268", "filename": "Listening Part C- Snoring answers.docx", "sha256": "9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.docx", "textPath": "imported-resources/text/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "\nDr Tredellow feels research on carotoid artery atherosclerosis\nA. is still in its infancy despite highlighting some serious issues.\nB. shows that snoring may be far more dangerous than once believed.\nC. demonstrates a clear connection between snoring and heart disease.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 460, "answer": {"text": "A", "source": {"id": "offline-9128392344abd0934268", "filename": "Listening Part C- Snoring answers.docx", "sha256": "9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.docx", "textPath": "imported-resources/text/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": "\nWhat does Dr Tredellow say about the treatment for snoring?\nA. Making specific lifestyle changes contributes to a reduction in snoring.\nB. There are too many causes of snoring to be able to treat them all.\nC. Treatment is best provided by a recognised sleep physician.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 769, "answer": {"text": "C", "source": {"id": "offline-9128392344abd0934268", "filename": "Listening Part C- Snoring answers.docx", "sha256": "9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.docx", "textPath": "imported-resources/text/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.json", "format": "docx", "role": "answer-key"}, "page": 1}}], "skills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, {"id": "offline-9128392344abd0934268", "filename": "Listening Part C- Snoring answers.docx", "sha256": "9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.docx", "textPath": "imported-resources/text/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.json", "format": "docx", "role": "answer-key"}], "passages": []}, {"id": "d2a1a5cedb8db432-p3", "label": "Part C · Listening Part C: Ebola", "part": "C", "sourceSha256": "d2a1a5cedb8db4327791ac26b343788cf901e8bb423db5b4c3c0320c38614229", "pages": [3, 4], "questions": [{"number": 1, "prompt": "\nWhy does Dr Munro say he volunteered to treat Ebola patients in Liberia?\nA. because of the high death rate from Ebola in Africa.\nB. because medical treatment in Africa can be aggressive.\nC. because he believed he had a duty to try and help.", "sourcePage": 3, "choices": ["A", "B", "C"], "kind": "question", "offset": 413, "answer": {"text": "C", "source": {"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "\nDr Munro says the patient’s he treated were often afraid because\nA. there was a high death rate for patients who received treatment.\nB. family members didn't believe that treatment was helping.\nC. they didn't trust the doctors because they were foreigners.", "sourcePage": 3, "choices": ["A", "B", "C"], "kind": "question", "offset": 697, "answer": {"text": "A", "source": {"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "\nWhat does Dr Munro say about the specialised clothing he had to wear?\nA. That he spent more time rehydrating than treating patients.\nB. That patients found it similar to what is worn in a hospital.\nC. That it affected the way he would treat his patients.", "sourcePage": 4, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "C", "source": {"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": "\nWhy does Dr Munro believe the case of the young girl is tragic?\nA. It highlights how even young children can get Ebola.\nB. It demonstrates how families were affected by the disease.\nC. It is a situation that only affected a small group of patients.", "sourcePage": 4, "choices": ["A", "B", "C"], "kind": "question", "offset": 294, "answer": {"text": "B", "source": {"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "\nTreating Ebola patients in Liberia has made Dr Munro\nA. improve how he manages the emotional needs of his patients.\nB. realise that seeing patients suffering is part of a doctor's job.\nC. understand that doctors can't do everything for their patients.", "sourcePage": 4, "choices": ["A", "B", "C"], "kind": "question", "offset": 582, "answer": {"text": "A", "source": {"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": "\nDr Munro believes Ebola may spread to other parts of the world because\nA. it takes longer for the disease to develop than people think.\nB. plane travel has made the world a much smaller place.\nC. an infected person in a crows could spread the disease.", "sourcePage": 4, "choices": ["A", "B", "C"], "kind": "question", "offset": 873, "answer": {"text": "A", "source": {"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, "page": 1}}], "skills": ["listening"], "recordings": [], "answerSources": [{"id": "offline-1f20667b3a7d32ebaa46", "filename": "Listening Part C- Ebola answers.docx", "sha256": "1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.docx", "textPath": "imported-resources/text/1f20667b3a7d32ebaa4681e25117d52d10a10638997a72d49b1b95d54e3dab79.json", "format": "docx", "role": "answer-key"}, {"id": "offline-9128392344abd0934268", "filename": "Listening Part C- Snoring answers.docx", "sha256": "9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.docx", "textPath": "imported-resources/text/9128392344abd09342685c6ab713ba88a12ea8fdb704b946812e38af4f8878d4.json", "format": "docx", "role": "answer-key"}], "passages": []}]}
