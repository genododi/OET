5f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 2, "prompt": "You hear an obstetrician describing a caesarean section to a pregnant\npatient.\nHe says that the procedure will\n(A) be shorter and less painful than a traditional birth.\n(B) be carried out while the patient is conscious.\n(C) not be necessary in the patient’s case.", "sourcePage": 13, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 25, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 3, "prompt": "You hear a GP and his practice nurse discussing their yearly schedule.\nThey agree that the practice should\n(A) hire agency staff to help during the busier weeks.\n(B) avoid taking holiday in the beginning of September.\n(C) look after their health, to lower the likelihood of sickness.", "sourcePage": 13, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 25, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 4, "prompt": "You hear a nurse preparing a patient for a flu shot.\nWhat is the nurse doing?\n(A) explaining why the flu shot is necessary\n(B) discussing why the flu shot causes reactions\n(C) describing common side effects of the flu shot", "sourcePage": 14, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 25, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 5, "prompt": "You hear a doctor talking to a patient about her injury.\nWhat will happen when the patient returns to the surgery?\n(A) She will have her stitches removed.\n(B) The doctor will stitch up her wound.\n(C) They will see if the wound will scar.", "sourcePage": 14, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 25, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}, {"number": 6, "prompt": "You hear a trainee nurse asking a senior colleague about the treatment\nfor a patient with chronic obstructive pulmonary disease, or COPD.\nThe senior colleague is explaining that giving such patients normal\nlevels of oxygen\n(A) can inhibit breathing rate.\n(B) will cause light-headedness.\n(C) lowers carbon dioxide levels.", "sourcePage": 14, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 25, "source": {"id": "offline-51c74510842bc49d5bab", "filename": "Listening Jahshan OET Collection.pdf", "sha256": "51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.pdf", "textPath": "imported-resources/text/51c74510842bc49d5babacdaf2a5b241a20e90979e03a98534645f748a7120fa.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["1922e4127e6d9e474f40fce51937f9fbcc4542e09a9dfb6393ee2b1c0869c117"], "answerSources": [], "matchEvidence": "Exact original recording SHA-256 in the verified Jahshan collection"}]}
