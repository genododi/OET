d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "_____________ is known to have the potential to create side effects when used\nfor long period.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 527, "answer": {"text": "Curcumin", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 20, "prompt": "____________ has the power to make cancer cells more vulnerable to radiation\ntherapy.", "sourcePage": 7, "choices": [], "kind": "question", "offset": 626, "answer": {"text": "Radiosensitizing Agent", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "f1d705b051008140-p8", "label": "Part B · READING 7.pdf", "part": "B", "sourceSha256": "f1d705b051008140e9e417a94bdb1cada131b5dba91cbca50ab64fe1d7197e83", "pages": [8, 9, 10, 11, 12, 13], "questions": [{"number": 6, "prompt": "What is correct?\nObesity rate increased from 2011-2012\nObesity rate increased from 2013-2014\nObesity rate increased from 2003-2004\nOverweight and Obesity\nThe prevalence of obesity among adults and youth in the UK significantly\nremained uncurtailed from 1999 to 2000 through 2013 to 2014. However, rate of\nenhancement ratio with respect to obesity prevalence began to level off and was\nnot statistically significant for adults from the time period 2003 to 2004 through\n2011 to 2012 and for youth from the time period 2003 to 2004 through 2013 to\n2014.\nBody mass index and waist circumference cut points in UK guidelines\nunderestimate obesity and CVD risk in Asian and South Asian populations.\nDefinitions of “metabolically healthy obesity” vary, and over time, a substantial\nproportion of those with metabolically healthy obesity transition to metabolically\nunhealthy.", "sourcePage": 13, "choices": [], "kind": "question", "offset": 0, "answer": {"text": ".Obesity rate increased from 2013-2014", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}], "passages": []}, {"id": "f1d705b051008140-p14", "label": "Part C · READING 7.pdf", "part": "C", "sourceSha256": "f1d705b051008140e9e417a94bdb1cada131b5dba91cbca50ab64fe1d7197e83", "pages": [14, 15, 16, 17, 18, 19, 20, 21], "questions": [{"number": 7, "prompt": "According to paragraph 1, what is true about exercise?\nExercise can reduce virtually all the risk levels associated with coronary\ndiseases and others.\nExercise may always enhance levels of HDLC.\nEnergy expenditure is always helpful in fighting diseases.\nAerobic exercises can increase HDLC levels effectively.", "sourcePage": 16, "choices": [], "kind": "question", "offset": 791, "answer": {"text": "Exercise may always enhance levels of HDLC.", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "According to paragraph 2, exercise is good for;\nPeople with high BP\nPeople with low BP\nPeople with mild BP\nNot given", "sourcePage": 16, "choices": [], "kind": "question", "offset": 1120, "answer": {"text": "People with mild BP", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 9, "prompt": "According to paragraph 3, exercise or any physical activity is reported to;\nEnhance quality of life for diabetic patients.\nTo improve cellâ€™s functionality to absorb insulin.\nCan stop the occurrence of diabetes.\nA&B", "sourcePage": 16, "choices": [], "kind": "question", "offset": 1256, "answer": {"text": "A & B", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 10, "prompt": "According to paragraph 4, which one of the following statements is true?", "sourcePage": 16, "choices": [], "kind": "question", "offset": 1492, "answer": {"text": "Dieting can be one of the best solutions to reduce weight.", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "What does the fifth paragraph indicate?\nRisks associated with exercise\nInjuries and exercise\nWhy exercise regimes should be supervised\nNot given", "sourcePage": 17, "choices": [], "kind": "question", "offset": 248, "answer": {"text": "Risks associated with exercise", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 12, "prompt": "What does the sixth paragraph describe?\nHow to gain more from exercising.\nWhy an exercise regime should be followed.\nExercise evaluation.\nThe importance of an exercise test.", "sourcePage": 17, "choices": [], "kind": "question", "offset": 413, "answer": {"text": ".Exercise evaluation.", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 13, "prompt": "According to paragraph 6, it is recommended that;\nPeople should exercise under the supervision of an expert trainer.\nAged people should not perform vigorous exercise.\nAny exercise program can be initiated without exercise testing.\nA&B", "sourcePage": 17, "choices": [], "kind": "question", "offset": 611, "answer": {"text": "Aged people should not perform vigorous exercise.", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 14, "prompt": "What information do we find in paragraph 7?\nCustomized training programs.\nHow exercise training programs should be.", "sourcePage": 17, "choices": [], "kind": "question", "offset": 870, "answer": {"text": ".How exercise training programs should be.", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 15, "prompt": "What paragraph 1 talks about?\nWhat is an aneurysm?\nAneurysms in the US.\nPrevalence of aneurysms.\nWhat is an aneurysm and how does it affect someone?", "sourcePage": 20, "choices": [], "kind": "question", "offset": 182, "answer": {"text": "Prevalence of aneurysms.", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 16, "prompt": "Paragraph 2 deals with?\nng aneurysms.\nHow do aneurysms form?\nWhen do aneurysms develop?", "sourcePage": 20, "choices": [], "kind": "question", "offset": 351}, {"number": 17, "prompt": "According to paragraph 2, which one of the following statements is not true?\nOften, people are born with aneurysms, but it is developed after the age of 40.\nAneurysms usually develop in people who are 40 years of age or more.\nAneurysms may pass on from one family to another family.\nCocaine may develop aneurysms in people.", "sourcePage": 20, "choices": [], "kind": "question", "offset": 454, "answer": {"text": "Often, people are born with aneurysms, but it is developed after the age of 40.", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "According to paragraph 3, which of the following is not correct about aneurysm\ntesting?\nPictures taken during the test are the primary source of the examination of\naneurysms.\nTests mentioned are efficient in detecting aneurysms larger than 3 to 5 mm.\nAn aneurysm is hard to detect if it is less than 3 mm.\nA cerebral angiogram can be as effective as an MRA.", "sourcePage": 20, "choices": ["A"], "kind": "question", "offset": 802, "answer": {"text": "Pictures taken during the test are the primary source of the examination of", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "What is the central idea of the paragraph 4?\nHow do aneurysms occur?\nWhat causes an aneurysm to bleed?\nBleeding in aneurysms\nHow does an aneurysm break?", "sourcePage": 21, "choices": [], "kind": "question", "offset": 0}, {"number": 20, "prompt": "What does paragraph 5 indicate?\nFactors that lead to bleeding\nWhat happens if an aneurysm bleeds?\nWhat are the chances that an unruptured aneurysm may bleed?\nB&C", "sourcePage": 21, "choices": [], "kind": "question", "offset": 173, "answer": {"text": ".B & C", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 21, "prompt": "According to paragraph 6, rapturing of an aneurysm is;\nFatal\nNot always detrimental\nFatal even if treated\nBrain-damaging and it is fatal", "sourcePage": 21, "choices": [], "kind": "question", "offset": 355, "answer": {"text": "Brain-damaging and it is fatal", "source": {"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}, "page": 1}}, {"number": 22, "prompt": "What paragraph 7 deal with?\nHow aneurysms affect the brain?\nBrain damage is certain in an aneurysm - how?\nWhy is the damage so extensive after the rupturing of an aneurysm?\nWhat is an ischemic stroke?", "sourcePage": 21, "choices": [], "kind": "question", "offset": 512}], "skills": ["reading"], "recordings": [], "answerSources": [{"id": "offline-4f519baa2ed856b6e021", "filename": "READING ANSWERS 7.pdf", "sha256": "4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.pdf", "textPath": "imported-resources/text/4f519baa2ed856b6e021d936e69b2f0f752e5d5ceb2eb6a4cd1b08860995fa3d.json", "format": "pdf", "role": "answer-key"}], "passages": []}]}
