ath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 20, "prompt": "Physical examination : blood pressure is 155/57, pulse rate is 61, respirations 18 & (20) ______\n              is 95% on room air. No lymph nodes or masses. No lower extremity edema. No\nredness or hotness.", "sourcePage": 99, "choices": [], "kind": "blank", "answer": {"text": "Oxygen Saturation", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 21, "prompt": "Diagnosis : laboratory reports show (21) ______                 and hemoglobin 9.6. Your chest x-ray is\nclear.", "sourcePage": 99, "choices": [], "kind": "blank", "answer": {"text": "Creatinine 2.1", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 22, "prompt": "Impression : (22) ______                to anticoagulation due to recurrent gastrointestinal bleed, status\npost IVC filter.", "sourcePage": 99, "choices": [], "kind": "blank", "answer": {"text": "Pulmonary Embolism With Contraindication", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 23, "prompt": ": (23) ______               disease, coronary artery disease, and", "sourcePage": 99, "choices": [], "kind": "blank", "answer": {"text": "Mitral Valve", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 24, "prompt": "disease, coronary artery disease, and (24) ______                 disease\nper Cardiology", "sourcePage": 99, "choices": [], "kind": "blank", "answer": {"text": "Peripheral Vascular", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["9dcb6dd76965a004eb1ab8168df31cbefc3bdbcd1bf83c50c5994c117e2f7cb9"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [108]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-9-B", "label": "British Academy · Task 9 · Part B", "part": "B", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [100, 101, 102], "questions": [{"number": 25, "prompt": "You hear a discussion between a physician and nurse explaining about schistosomiasis\nand its causes.\n\nWhich of the following is the infectious form of schistosomiasis?\n\nA. Schistosoma mansoni\n\nB. Cercariae\n\nC. S. Haematobium", "sourcePage": 100, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 26, "prompt": "You hear a discussion between two doctors about the importance of measuring serum\namylase or serum lipase\n\nWhich of the following statements is correct?\n\nA. Measuring only serum amylase is adequate for diagnosing acute pancreatitis.\n\nB. The sensitivity and specificity of serum amylase is more than serum lipase.\n\nC. Serum lipase rises more quickly and remains elevated longer.", "sourcePage": 100, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 27, "prompt": "You hear a discussion between two doctors about the misdiagnosing of acute\ncardiorenal syndrome as renal injury due to hypovolemia.\n\nWhat is the suggested method to differentiate acute cardiorenal syndrome & renal injury\ndue to hypovolemia?\n\nA. Assessing the history of recent diuretic overuse\n\nB. Evaluating the urine electrolytes\n\nC. Diagnosing hypervolemia", "sourcePage": 101, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 28, "prompt": "You hear a physician explaining to his nurse about sepsis & infection.\n\nWhich of the following germs is also called staph?\n\nA. Escherichia Coli\n\nB. Streptococcus\n\nC. Staphylococcus aureus", "sourcePage": 101, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 29, "prompt": "You hear a discussion between two doctors about brain imaging prior to lumbar\npuncture in the suspected cases of bacterial meningitis.\n\n\n\nWhich of the following statement is correct?\n\nA. Lumbar puncture should be delayed for patients with focal neurologic deficits.\n\nB. Can start the treatment even without a lumbar puncture with obtaining the blood culture\nreport.\n\nC. A brain imaging should be performed for all the patients with bacterial meningitis.", "sourcePage": 101, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 30, "prompt": "You hear a monologue by a physician about managing aneurysmal subarachnoid\nhemorrhage.\n\nWhich of the following is a significant symptom of aneurysmal subarachnoid hemorrhage?\n\nA. Rebleeding\n\nB. Severe headache\n\nC. Cardiac and pulmonary abnormalities\n\n                                            Part C\nIn this part of the test, you'll hear two different extracts. In each extract, you'll hear health\nprofessionals talking about specific aspects of their work.\n\nFor questions 31 to 42 choose the answer (A, B, or C) which fits best according to what you\nhear. Complete the answers as you listen the audio.\n\nNow, look at extract one.", "sourcePage": 102, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["9dcb6dd76965a004eb1ab8168df31cbefc3bdbcd1bf83c50c5994c117e2f7cb9"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [108]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-9-C", "label": "British Academy · Task 9 · Part C", "part": "C", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [103, 104, 105, 106, 107], "questions": [{"number": 31, "prompt": "Which of the following statements is correct?\n\nA. If the primary problem of cardiorenal syndrome is in the heart it is called renocardiac\nsyndrome.\n\nB. Acute exacerbation of heart failure is called renocardiac syndrome.\n\nC. If the primary problem is not in the heart or kidneys then the condition is called secondary\ncardiorenal syndrome.", "sourcePage": 103, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 32, "prompt": "Which of the following involves the end-stage kidney disease?\n\nA. RIFLE\n\nB. AKIN\n\nC. Acute cardiorenal syndrome", "sourcePage": 103, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 33, "prompt": "Cardiogenic shock is characterized by;\n\nA. Worsening pulmonary\n\nB. Hypoperfusion\n\nC. Hypervolemia", "sourcePage": 104, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 34, "prompt": "Which of the following statements is correct?\n\nA. Hypovolemic is the hallmark of acute heart failure.\n\nB. Worsening pulmonary is a condition in cardiogenic shock.\n\nC. Hypoperfusion can cause systemic organ damage.", "sourcePage": 104, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 35, "prompt": "Renal perfusion is reduced in acute heart failure due to\n\nA. Renal venous congestion\n\nB. Hypoperfusion\n\nC. Abrupt decrease of cardiac pump function", "sourcePage": 104, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 36, "prompt": "Which of the following effects is not caused by aggravation in sympathetic\nhyperactivity?\n\nA. Increased renal perfusion\n\nB. Constriction of efferent and afferent arterioles\n\nC. Increased tubular sodium and water reabsorption", "sourcePage": 105, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 37, "prompt": "Which of the following statements is incorrect?\n\nA. Anticoagulation is inevitable in the patients with endocarditis\n\nB. Endocarditis alone is not an indication for anticoagulation\n\nC. Anticoagulation may be suggested if the endocarditis patient has vein thrombosis", "sourcePage": 105, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 38, "prompt": "According to the studies, anticoagulation therapy;\n\nA. Increased the cerebrovascular complications\n\nB. Prevented the growth and propagation of vegetation\n\nC. Increased the vegetation size", "sourcePage": 106, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 39, "prompt": "Which of the following statements is incorrect?\n\nA. Ischemic stroke in patients who received anticoagulation was underestimated.\n\nB. The beneficial effects at least counterbalance the harmful effects of anticoagulation.\n\nC. There was no increase in the rate of hemorrhagic lesions in the patients who received\nanticoagulation therapy.", "sourcePage": 106, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 40, "prompt": "The studies show that anticoagulation was beneficial;\n\nA. Once antimicrobial therapy had begun\n\nB. When the patients received warfarin before diagnosis\n\nC. For the patients with non native valve", "sourcePage": 106, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 41, "prompt": "Which of the following statements is incorrect?\n\nA. Patients suspected for stroke should continue with anticoagulation therapy\n\nB. Patients with pathogens such as Candida spp should suspend anticoagulation therapy\n\nC. Anticoagulation therapy for the sole purpose of stroke prevention is not advised for the\npatients with newly diagnosed endocarditis.", "sourcePage": 107, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 42, "prompt": "Low-molecular weight heparin can be given if;\n\nA. Surgery is considered\n\nB. Surgery is not anticipated\n\nC. In both the cases", "sourcePage": 107, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 108, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["9dcb6dd76965a004eb1ab8168df31cbefc3bdbcd1bf83c50c5994c117e2f7cb9"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [108]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}]}
