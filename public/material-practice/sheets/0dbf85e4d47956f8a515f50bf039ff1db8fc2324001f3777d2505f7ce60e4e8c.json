ps://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 2, "prompt": "stenosis including (2) ______              he was working as a driver with a beverage company, but\nnow he has retired due to his condition", "sourcePage": 168, "choices": [], "kind": "blank", "answer": {"text": "Decompression And Epidural Steroids", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 3, "prompt": "Past surgeries : (3) ______               on the left. Baker's cyst. Colon cancer removal. Bilateral\nknee scopes. Right groin hernia.", "sourcePage": 168, "choices": [], "kind": "blank", "answer": {"text": "Inguinal Hernia", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 4, "prompt": "knee scopes. Right groin hernia. (4) ______               Status post colon cancer, second surgery.", "sourcePage": 168, "choices": [], "kind": "blank", "answer": {"text": "Low Back Surgery For Spinal Stenosis", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 5, "prompt": "Medications : Ambien 12.5 mg bedtime. (5) ______                     Lisinopril 10 mg daily. Demerol for\npain.", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Methadone 10 Mg Twice A Day", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 6, "prompt": "Allergies : (6) ______                cause rashes; ibuprofen causes his throat to swell, Fortaz", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Levaquin And Cipro", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 7, "prompt": "(7) ______", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Causes An Unknown Reaction", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 8, "prompt": "Diagnosis : Musculoskeletal examination of left knee reveals a (8) ______                extension, 126\nflexion. Extensor mechanism is intact. There is mild varus. Has good stability at", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Range Of Minus 10 Degrees", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 9, "prompt": "flexion. Extensor mechanism is intact. There is mild varus. Has good stability at\n (9) ______", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "30 Degrees Of Flexion", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 10, "prompt": "(10) ______               are negative Has good muscle turgor. Dorsalis pedis pulse\n2+. X-rays reveal severe bilateral knee degenerated joint disease with joint space narrowing\nmedially as well as the", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Lachman's And Posterior Drawer", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 11, "prompt": "medially as well as the (11) ______               left greater than right.", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Patellofemoral Joint With Large Osteophytes", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 12, "prompt": "Impression : paresthesias down into thighs (12) ______                 bilateral knee degenerative joint\ndisease. significant back pain, status post lumbar stenosis surgery.", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Secondary To Spinal Stenosis", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 13, "prompt": "pneumonia and abdominal discomfort had an endoscopy which revealed a (13) ______\nNow he feels anemic. had a CT scan last week that showed", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Small Ulcer After Dropping Hematocrit", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 14, "prompt": "Now he feels anemic. had a CT scan last week that showed (14) ______                         worrisome\nfor", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Pneumatosis And Cecum", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 15, "prompt": "for (15) ______              bilateral hydronephrosis and multiple liver lesions. Yesterday he had", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Ischemic Colitis", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 16, "prompt": "(16) ______            and passing flatus and has", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Multiple Bowel Movements", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 17, "prompt": "and passing flatus and has (17) ______                      chronic alcohol user, stopped\nsmoking long back", "sourcePage": 169, "choices": [], "kind": "blank", "answer": {"text": "Epigastric Pain", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 18, "prompt": "Past medical history : (18) ______                 history of pneumonia, and aspiration pneumonia,\nosteoporosis, alcoholism,", "sourcePage": 170, "choices": [], "kind": "blank", "answer": {"text": "Chronic Obstructive Pulmonary Disease", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 19, "prompt": "osteoporosis, alcoholism, (19) ______", "sourcePage": 170, "choices": [], "kind": "blank", "answer": {"text": "Microcytic Anemia", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 20, "prompt": "Physical Examination : he is afebrile. Heart rate in the 100s to 120s at times with\n (20) ______              Respiratory rate is 17-20. Blood pressure 130s-150s & 60s-70s. abdomen is\ndistended with tenderness mainly in the upper abdomen but very difficult to localize.", "sourcePage": 170, "choices": [], "kind": "blank", "answer": {"text": "With Atrial Fibrillation", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 21, "prompt": "Diagnosis : CT scan shows (21) ______                 with an enlarged cecum filled with stool and air\nfluid levels with chronically dilated small bowel.", "sourcePage": 170, "choices": [], "kind": "blank", "answer": {"text": "Pneumatosis In The Cecum", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 22, "prompt": "Further diagnosis : a repeat CT scan to assess it further to see if there is (22) ______\n versus resolution to further", "sourcePage": 170, "choices": [], "kind": "blank", "answer": {"text": "Worsening Of Pneumatosis", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 23, "prompt": "versus resolution to further (23) ______             and make decisions regarding planning at that\ntime. Since he has frequent desaturations secondary to his aspiration pneumonia, any surgical\nprocedure or any surgical intervention certainly require", "sourcePage": 170, "choices": [], "kind": "blank", "answer": {"text": "Evaluate The Liver Lesions", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 24, "prompt": "procedure or any surgical intervention certainly require (24) ______               that would then\nnecessitate long-term ventilator care. Decisions on further treatment will be based on the repeat\nCT scan.", "sourcePage": 170, "choices": [], "kind": "blank", "answer": {"text": "Intubation", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["0dbf85e4d47956f8a515f50bf039ff1db8fc2324001f3777d2505f7ce60e4e8c"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [177]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used"}, {"id": "british-academy-task-15-B", "label": "British Academy · Task 15 · Part B", "part": "B", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [170, 171, 172], "questions": [{"number": 25, "prompt": "You hear a discussion between a doctor and nurse about the cause of glioma.\n\nWhich of the following types of glioma involve the cells that provide myelin?\n\nA. Oligodendroglioma\n\nB. Ependymoma\n\n\n\nC. Astrocytoma", "sourcePage": 170, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 26, "prompt": "You hear a discussion between a doctor and nurse about Gaucher's Disease Genetics.\n\nWhich of the following mutations affects the infants?\n\nA. 1 or 2 copies of L444P\n\nB. N370S\n\nC. 1 or 2 alleles of L444P", "sourcePage": 171, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 28, "prompt": "You hear a discussion between a doctor and nurse about hyperelastic skin.\n\nThe skin becomes stretchable beyond the normal level, when;\n\nA. The collagen level is low\n\nB. There is an increased elastin\n\nC. The person has Ehlers-Danlos syndrome", "sourcePage": 171, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 29, "prompt": "You hear a discussion between a doctor and nurse about cancer of unknown primary.\n\nWhich of the following type of cancer of unknown primary forms from gland cells?\n\nA. Squamous cell cancer\n\nB. Neuroendocrine carcinoma\n\nC. Adenocarcinomas", "sourcePage": 172, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 30, "prompt": "You hear a discussion between a doctor and nurse about Sarin Classification.\n\nWhich of the following gastric varices leads to greater curvature of the abdomen?\n\nA. Type 2 - gastroesophageal varix\n\nC. Type 1 - gastroesophageal varix\n\nC. Type 1 - Isolated gastric varix\n\n                                              Part C\nIn this part of the test, you'll hear two different extracts. In each extract, you'll hear health\nprofessionals talking about specific aspects of their work.\n\nFor questions, 31 to 42 choose the answer (A, B, or C) which fits best according to what you\nhear. Complete the answers as you listen the audio.\n\n\n\nNow, look at extract one.", "sourcePage": 172, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["0dbf85e4d47956f8a515f50bf039ff1db8fc2324001f3777d2505f7ce60e4e8c"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper", "pages": [177]}], "matchEvidence": "Reviewed patient cases and question topics in the exact-recording transcript against the printed task paper; task filename alone is not used", "notice": "The supplied paper and key omit Question 27. It has not been invented. The source has missing or repeated option labels in Question(s) 30. Check the original; its wording is retained."}, {"id": "british-academy-task-15-C", "label": "British Academy · Task 15 · Part C", "part": "C", "sourceSha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "pages": [173, 174, 175, 176], "questions": [{"number": 31, "prompt": "Which of the following statements is correct?\n\nA. Pemphigus is an autoimmune disease\n\nB. Pemphigus is a genetic disease\n\nC. Pemphigus disease can spread person to person", "sourcePage": 173, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 32, "prompt": "Crusty sores are formed in;\n\nA. Pemphigus vulgaris\n\nB. Pemphigus foliaceus\n\nC. All types of pemphigus diseases", "sourcePage": 173, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 33, "prompt": "The type of pemphigus that affects the mucous membranes is;\n\nA. IgA pemphigus\n\nB. Pemphigus foliaceus\n\nC. Pemphigus vulgaris", "sourcePage": 173, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 34, "prompt": "The disease that affects the scalp is;\n\nA. Pemphigus foliaceus\n\nB. IgA pemphigus\n\nC. Paraneoplastic Pemphigus", "sourcePage": 174, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 35, "prompt": "Which of the following is a characteristics of Paraneoplastic Pemphigus?\n\nA. Forming crusty sores on the scalp and face\n\nB. Eyelids becoming cut and scarred\n\nC. Affecting mucous membranes", "sourcePage": 174, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 36, "prompt": "pus-containing bumps are formed in\n\nA. IgA pemphigus\n\nB. Vegetans\n\nC. Paraneoplastic Pemphigus", "sourcePage": 174, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 37, "prompt": "In acute pericarditis, the pain increases;\n\nA. During expiration\n\nB. While sitting\n\nC. Lying down", "sourcePage": 175, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 38, "prompt": "Which of the following symptoms is not seen in the patients with chronic pericarditis?\n\nA. Chest pain\n\nB. Tiredness\n\nC. Coughing", "sourcePage": 175, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 39, "prompt": "Which of the following conditions is caused due to gradual accumulation of fluid\nwithin the pericardial cavity?\n\nA. Chronic pericarditis\n\nB. Pericardial effusion\n\nC. Constrictive pericarditis", "sourcePage": 175, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "B", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 40, "prompt": "The condition caused due to thickening of pericardial layers is;\n\nA. Cardiac tamponade\n\nB. Pericardial effusion\n\nC. Constrictive pericarditis", "sourcePage": 176, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "C", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 41, "prompt": "The condition caused when the pericardial fluid volume increases about 80 ml is;\n\nA. Cardiac tamponade\n\nB. Pericardial effusion\n\nC. Purulent pericarditis", "sourcePage": 176, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}, {"number": 42, "prompt": "The type of pericarditis commonly seen in the patients with Hodgkin’s disease is;\n\nA. Malignancy pericarditis\n\nB. Traumatic pericarditis\n\nC. Radiation Pericarditis", "sourcePage": 176, "choices": ["A", "B", "C"], "kind": "question", "answer": {"text": "A", "page": 177, "source": {"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.json", "format": "pdf", "role": "paper"}}}], "skills": ["listening"], "recordings": ["0dbf85e4d47956f8a515f50bf039ff1db8fc2324001f3777d2505f7ce60e4e8c"], "answerSources": [{"id": "offline-0300375e981d9b16a421", "filename": "Listening Tests 1 - 15.pdf", "sha256": "0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0300375e981d9b16a4214982bdc40c52b4b76d2e6197811448bc8dcb96f2f8fc.pdf", "textPath": "imported-resources/text/0300375e