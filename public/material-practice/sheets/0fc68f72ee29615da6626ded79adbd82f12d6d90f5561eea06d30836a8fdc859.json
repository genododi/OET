0336319", "filename": "practice-test-part-A.pdf", "sha256": "98f0aaf6382a30336319e51a7ec1901760a328e52b19f65846df38bcc9478b66", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-2/98f0aaf6382a30336319e51a7ec1901760a328e52b19f65846df38bcc9478b66.pdf", "textPath": "imported-resources/text/98f0aaf6382a30336319e51a7ec1901760a328e52b19f65846df38bcc9478b66.json", "format": "pdf", "role": "paper"}, {"id": "offline-cb4d50b7f64fd21057b1", "filename": "Part C Answers.jpg", "sha256": "cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.jpg", "textPath": "imported-resources/text/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.json", "format": "jpg", "role": "answer-key"}], "units": [{"id": "98f0aaf6382a3033-p1", "label": "Part A · practice-test-part-A.pdf", "part": "A", "sourceSha256": "98f0aaf6382a30336319e51a7ec1901760a328e52b19f65846df38bcc9478b66", "pages": [1, 2, 3, 4, 5, 6, 7], "questions": [{"number": 1, "prompt": "what patients should and shouldn’t do when they return home? _____", "sourcePage": 5, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 635}, {"number": 2, "prompt": "the possible cause of abnormality apparent in a patient’s eyes? _____", "sourcePage": 5, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 710}, {"number": 3, "prompt": "reasons why patients should seek medical attention after being discharged?\n_____", "sourcePage": 5, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 788}, {"number": 4, "prompt": "procedures to follow dependent on the type of head injury? _____", "sourcePage": 5, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 884}, {"number": 5, "prompt": "past interventions and conditions to be considered when assessing risk?\n_____", "sourcePage": 5, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 957, "answer": {"text": "C", "source": {"id": "offline-0505200673b5e279ee3c", "filename": "Part A Answers.jpg", "sha256": "0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.jpg", "textPath": "imported-resources/text/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 11, "prompt": "Escalation:​ Children assessed as intermediate or high risk should undergo a ​(11) ____________", "sourcePage": 6, "choices": [], "kind": "blank", "offset": 399, "answer": {"text": "CT scan", "source": {"id": "offline-0505200673b5e279ee3c", "filename": "Part A Answers.jpg", "sha256": "0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.jpg", "textPath": "imported-resources/text/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 18, "prompt": "​What should you provide head injury patients with when you discharge them?\n________", "sourcePage": 7, "choices": [], "kind": "question", "offset": 257, "answer": {"text": "(head injury) advice sheet", "source": {"id": "offline-0505200673b5e279ee3c", "filename": "Part A Answers.jpg", "sha256": "0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.jpg", "textPath": "imported-resources/text/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 19, "prompt": "​What should you advise patients to take to control headaches?\n________", "sourcePage": 7, "choices": [], "kind": "question", "offset": 354, "answer": {"text": "(simple) painkillers", "source": {"id": "offline-0505200673b5e279ee3c", "filename": "Part A Answers.jpg", "sha256": "0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.jpg", "textPath": "imported-resources/text/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 20, "prompt": "​What can patients use to avoid contact between ice packs and their skin?\n________", "sourcePage": 7, "choices": [], "kind": "question", "offset": 438, "answer": {"text": "(a) towel", "source": {"id": "offline-0505200673b5e279ee3c", "filename": "Part A Answers.jpg", "sha256": "0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.jpg", "textPath": "imported-resources/text/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.json", "format": "jpg", "role": "answer-key"}, "page": 1}}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [{"id": "offline-0505200673b5e279ee3c", "filename": "Part A Answers.jpg", "sha256": "0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.jpg", "textPath": "imported-resources/text/0505200673b5e279ee3cb328aa42835afeec5325ee93c0704f99cf2f3aeb1039.json", "format": "jpg", "role": "answer-key"}], "passages": []}, {"id": "78b6b4d03cce30ad-p1", "label": "Part B · Practice-test-part-B.pdf", "part": "B", "sourceSha256": "78b6b4d03cce30ad04cd7782fe81c1356c5860328fa8114cb2c597b618944aac", "pages": [1, 2, 3, 4], "questions": [{"number": 2, "prompt": "What do we learn about the use of TENS machines?\nA       Evidence for their efficacy is unconfirmed.\nB       They are recommended in certain circumstances.\nC       More research is needed on their possible side effects.\nUpdate on TENS machines\nThe Association of Chartered Physiotherapists in Women’s Health has an expert panel which\ncould not find any reports suggesting that negative effects are produced when TENS has\nbeen used during pregnancy. However, in clinical practice, TENS is not the first treatment of\nchoice for women presenting with musculoskeletal pain during pregnancy. The initial\ntreatment should be aimed at correcting any joint or muscle dysfunction, and a rehabilitation\nprogramme should be devised. However, if pain remains a significant factor, then TENS is\npreferable to the use of strong medication that could cross the placental barrier and affect\nthe foetus. No negative effects have been reported following the use of this modality during\nany of the stages of pregnancy. Therefore, TENS is preferable for the relief of pain.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "B", "source": {"id": "offline-0fc68f72ee29615da662", "filename": "Part B Answers.jpg", "sha256": "0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859.jpg", "textPath": "imported-resources/text/0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": "What is the memo doing?\nA      providing an update on the success of new guidelines\nB      reminding staff of the need to follow new guidelines\nC      announcing the introduction of new guidelines\nMemo: Administration of antibiotics\nAfter a thorough analysis and review, our peri-operative services, in conjunction with the\nDepartments of Surgery and Anaesthesia, decided to change the protocols for the\nadministration of pre-operative antibiotics and established a series of best practice\nguidelines. This has resulted in a significant improvement in the number of patients\nreceiving antibiotics within the recommended 60 minutes of their incision. A preliminary\nreview of the total hip and knee replacements performed in May indicates that 88.9% of\npatients received their antibiotics on time.", "sourcePage": 4, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "A", "source": {"id": "offline-0fc68f72ee29615da662", "filename": "Part B Answers.jpg", "sha256": "0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859.jpg", "textPath": "imported-resources/text/0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859.json", "format": "jpg", "role": "answer-key"}, "page": 1}}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [{"id": "offline-0fc68f72ee29615da662", "filename": "Part B Answers.jpg", "sha256": "0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859.jpg", "textPath": "imported-resources/text/0fc68f72ee29615da6626ded79adbd82f12d6d90f5561eea06d30836a8fdc859.json", "format": "jpg", "role": "answer-key"}], "passages": []}, {"id": "96627eb498f51846-p1", "label": "Part C · Practice-test-part-C.pdf", "part": "C", "sourceSha256": "96627eb498f518464796e1b23da197bb1808cf512b1657cae745f21e2ca73cfa", "pages": [1, 2, 3, 4, 5], "questions": [{"number": 1, "prompt": "In the first paragraph, what reason for the misdiagnosis of CO poisoning is highlighted?\nA    the limited experience physicians have of it\nB    the wide variety of symptoms associated with it\nC    the relative infrequency with which it is presented\nD    the way it is concealed by pre-existing conditions", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 197, "answer": {"text": "B", "source": {"id": "offline-cb4d50b7f64fd21057b1", "filename": "Part C Answers.jpg", "sha256": "cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.jpg", "textPath": "imported-resources/text/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "In the second paragraph, the writer stresses the danger of delays in diagnosis leading to\nA    the inefficient use of scarce resources.\nB    certain symptoms being misinterpreted.\nC    a deterioration in the patient's condition.\nD    the evidence of poisoning disappearing.", "sourcePage": 3, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 526, "answer": {"text": "D", "source": {"id": "offline-cb4d50b7f64fd21057b1", "filename": "Part C Answers.jpg", "sha256": "cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.jpg", "textPath": "imported-resources/text/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": "In the fourth paragraph, confusion is given as a symptom of\nA   short-term exposure to high levels of CO.\nB   repeated exposure to varying levels of CO.\nC   a relatively low overall level of exposure to CO.", "sourcePage": 3, "choices": ["A", "B", "C"], "kind": "question", "offset": 1075, "answer": {"text": "4", "source": {"id": "offline-cb4d50b7f64fd21057b1", "filename": "Part C Answers.jpg", "sha256": "cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.jpg", "textPath": "imported-resources/text/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "In the fifth paragraph, what point is made about COHb levels?\nA They fail to detect CO poisoning in habitual smokers.\nB They are a generally reliable indicator of CO poisoning.\nC   They correlate very well with extreme levels of CO poisoning.\nD   They are most useful in determining intermediate levels of CO poisoning.", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 58, "answer": {"text": "C", "source": {"id": "offline-cb4d50b7f64fd21057b1", "filename": "Part C Answers.jpg", "sha256": "cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.jpg", "textPath": "imported-resources/text/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.json", "format": "jpg", "role": "answer-key"}, "page": 1}}, {"number": 8, "prompt": "What reservation about the CO-Oximeter does the writer express?\nA   It does not always give an immediate result.\nB   Its use needs to be approved by a physician.\nC   It requires a skilled analyst to interpret the readings.\nD   It does not show variations in the patient's condition.", "sourcePage": 4, "choices": ["A", "B", "C", "D"], "kind": "question", "offset": 963, "answer": {"text": "D", "source": {"id": "offline-cb4d50b7f64fd21057b1", "filename": "Part C Answers.jpg", "sha256": "cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.jpg", "textPath": "imported-resources/text/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.json", "format": "jpg", "role": "answer-key"}, "page": 1}}], "skills": ["listening", "reading", "writing", "speaking"], "recordings": [], "answerSources": [{"id": "offline-cb4d50b7f64fd21057b1", "filename": "Part C Answers.jpg", "sha256": "cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-3/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.jpg", "textPath": "imported-resources/text/cb4d50b7f64fd21057b128b9ba7956feb347cf9ca6fa3661c94f23b2cad9f3b4.json", "format": "jpg", "role": "answer-key"}], "passages": []}]}
