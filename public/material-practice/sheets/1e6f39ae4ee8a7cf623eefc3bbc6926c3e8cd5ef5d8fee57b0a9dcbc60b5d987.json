{"version": 1, "sourceSha256": "1e6f39ae4ee8a7cf623eefc3bbc6926c3e8cd5ef5d8fee57b0a9dcbc60b5d987", "documents": [{"id": "offline-1e6f39ae4ee8a7cf623e", "filename": "Listening B.mp3", "sha256": "1e6f39ae4ee8a7cf623eefc3bbc6926c3e8cd5ef5d8fee57b0a9dcbc60b5d987", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19-5/1e6f39ae4ee8a7cf623eefc3bbc6926c3e8cd5ef5d8fee57b0a9dcbc60b5d987.mp3", "textPath": "imported-resources/text/1e6f39ae4ee8a7cf623eefc3bbc6926c3e8cd5ef5d8fee57b0a9dcbc60b5d987.json", "format": "mp3", "role": "recording"}, {"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}, {"id": "offline-a4e7ae1af374992f9198", "filename": "Part B.pdf", "sha256": "a4e7ae1af374992f919826e24d859cf65deba44fd4be7e0471c4c3d6de119636", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/a4e7ae1af374992f919826e24d859cf65deba44fd4be7e0471c4c3d6de119636.pdf", "textPath": "imported-resources/text/a4e7ae1af374992f919826e24d859cf65deba44fd4be7e0471c4c3d6de119636.json", "format": "pdf", "role": "paper"}], "units": [{"id": "a4e7ae1af374992f-p1", "label": "Part B · Part B.pdf", "part": "B", "sourceSha256": "a4e7ae1af374992f919826e24d859cf65deba44fd4be7e0471c4c3d6de119636", "pages": [1, 2, 3], "questions": [{"number": 1, "prompt": "\nYou hear a doctor talking to the daughter of a patient from an aged care home.\nThe doctor wants to\nA. ensure that Mrs Cox's father has a good quality of life.\nB. advise Mrs Cox that her father has Alzheimer's disease.\nC. explain the improvements in medical treatment to Mrs Cox.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 424, "answer": {"text": "A", "source": {"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 2, "prompt": "\nYou hear a consultant giving a talk to a group of trainees.\nWhat is the purpose of the talk?\nA. to highlight the symptoms associated with a head injury.\nB. to discuss the importance of waking patients after a head injury.\nC. to convey the significance of the initial 24 hours after a head injury.", "sourcePage": 1, "choices": ["A", "B", "C"], "kind": "question", "offset": 802, "answer": {"text": "C", "source": {"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 3, "prompt": "\nYou head a vet talking to a client who brought this pet cat, Jimmy, to the vet clinic.\nWhat does the vet say has caused Jimmy's problem urinating?\nA. Stress from renovations.\nB. A fatal urethral obstruction.\nC. Struvite cyrstals in his urethra", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 19, "answer": {"text": "C", "source": {"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 4, "prompt": "\nYou hear the nurse unit manager (NUM) discussing the progress if a patient at a multi-\ndisciplinary team meeting.\nWhat does she indicate about the patient's son?\nA. That he hasn't been feeding the patient.\nB. That the patient is largely dependent on him.\nC. That he is having problems in his role as a carer.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 358, "answer": {"text": "B", "source": {"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 5, "prompt": "\nYou hear a radiographer talking to nursing staff at an aged care centre.\nThe radiographer is\nA. helping nurses prepare patients for CT scans.\nB. stressing the importance of contrast media in CT scans.\nC. highlighting problems that occur when conducting CT scans.", "sourcePage": 2, "choices": ["A", "B", "C"], "kind": "question", "offset": 762, "answer": {"text": "A", "source": {"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}, "page": 1}}, {"number": 6, "prompt": "\nYou hear a GP discussing psoriasis with a patient.\nThe GP recommends sunbed treatment because\nA. UVB light is unique in a hospital setting.\nB. there is currently a shortage of cream.\nC. it will help with the effects of the rash.", "sourcePage": 3, "choices": ["A", "B", "C"], "kind": "question", "offset": 0, "answer": {"text": "C", "source": {"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}, "page": 1}}], "skills": ["listening"], "recordings": ["1e6f39ae4ee8a7cf623eefc3bbc6926c3e8cd5ef5d8fee57b0a9dcbc60b5d987"], "answerSources": [{"id": "offline-7a491224b8a9f50cc90f", "filename": "Listening Part B-answers.docx", "sha256": "7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95", "assetPath": "https://github.com/genododi/OET/releases/download/genododi-library-2026-10-19/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.docx", "textPath": "imported-resources/text/7a491224b8a9f50cc90f6e31adc37953dc335f02fa7092c792b6608bdb996c95.json", "format": "docx", "role": "answer-key"}], "passages": []}]}
